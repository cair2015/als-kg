    skos:definition "MolecularSubtype-to-Anatomy relationship indicating the tissue or biological context in which the molecular subtype was characterized. Edge direction is MolecularSubtype -> Anatomy." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#MEASURES_GENE_EXPRESSION_OF> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "MEASURES_GENE_EXPRESSION_OF" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#MODELS_SUBTYPE> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "MODELS_SUBTYPE" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#MODULATES_PATHOGENIC_MECHANISM> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "MODULATES_PATHOGENIC_MECHANISM" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#MODULATOR> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "MODULATOR" ;
    skos:definition "Drug modulates the gene product or target associated with the gene." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#NEGATIVE_ALLOSTERIC_MODULATOR> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "NEGATIVE_ALLOSTERIC_MODULATOR" ;
    skos:definition "Drug acts as a negative allosteric modulator of the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#NEGATIVE_MODULATOR> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "NEGATIVE_MODULATOR" ;
    skos:definition "Drug negatively modulates the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#OCCURS_IN_ANATOMY> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "OCCURS_IN_ANATOMY" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#OCCURS_IN_CELL_TYPE> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "OCCURS_IN_CELL_TYPE" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#OCCURS_IN_SUBTYPE_CONTEXT> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "OCCURS_IN_SUBTYPE_CONTEXT" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#OFF_LABEL_USE> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "OFF_LABEL_USE" ;
    skos:definition "Drug has off-label use for a disease or phenotype context." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#OPENER> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "OPENER" ;
    skos:definition "Drug opens the gene product or target, often a channel target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#PARENT> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "PARENT" ;
    skos:definition "Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#PARTIAL_AGONIST> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "PARTIAL_AGONIST" ;
    skos:definition "Drug acts as a partial agonist of the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#PHENOTYPE_PRESENT> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "PHENOTYPE_PRESENT" ;
    skos:definition "Disease-to-phenotype relationship indicating the phenotype is present in the disease context." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#POSITIVE_ALLOSTERIC_MODULATOR> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "POSITIVE_ALLOSTERIC_MODULATOR" ;
    skos:definition "Drug acts as a positive allosteric modulator of the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#POSITIVE_MODULATOR> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "POSITIVE_MODULATOR" ;
    skos:definition "Drug positively modulates the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#PRIORITIZES_DRUG> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "PRIORITIZES_DRUG" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#RELEASING_AGENT> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "RELEASING_AGENT" ;
    skos:definition "Drug acts as a releasing agent affecting the gene product or related target system." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#STABILISER> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "STABILISER" ;
    skos:definition "Drug stabilizes the gene product or target." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#SUBSTRATE> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "SUBSTRATE" ;
    skos:definition "Drug is a substrate of the gene product, often an enzyme or transporter." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#SUPPORTED_BY> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "SUPPORTED_BY" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#SYNERGISTIC_INTERACTION> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "SYNERGISTIC_INTERACTION" ;
    skos:definition "Drug-drug relationship indicating synergistic interaction." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#TARGET> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "TARGET" ;
    skos:definition "Drug targets the gene product associated with the gene." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#TARGETS_GENE> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "TARGETS_GENE" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#TESTED_IN_CLINICAL_TRIAL> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "TESTED_IN_CLINICAL_TRIAL" ;
    skos:definition "ALS-KG extension relationship type for Neo4j materialization." .

<https://w3id.org/alskg/schema/RelationshipTypeEnum#TRANSPORTER> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "TRANSPORTER" ;
    skos:definition "Drug-gene relationship where the gene product is a transporter in pharmacologic context." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#clinically_tested> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "clinically_tested" ;
    skos:definition "Hypothesis has been evaluated in a clinical trial or observational clinical study." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#deprioritized> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "deprioritized" ;
    skos:definition "Hypothesis is deprioritized because of weak evidence, wrong direction, toxicity, or lack of feasibility." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#experimentally_supported> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "experimentally_supported" ;
    skos:definition "Hypothesis has supporting experimental-model evidence." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#prioritized> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "prioritized" ;
    skos:definition "Hypothesis has been ranked or prioritized for further study." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#proposed> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "proposed" ;
    skos:definition "Hypothesis is proposed based on KG, literature, omics, or computational evidence." .

<https://w3id.org/alskg/schema/RepurposingStatusEnum#rejected> a owl:NamedIndividual, alskg:RepurposingStatusEnum ;
    rdfs:label "rejected" ;
    skos:definition "Hypothesis is rejected based on negative or contradictory evidence." .

<https://w3id.org/alskg/schema/SexEnum#female> a owl:NamedIndividual, alskg:SexEnum ;
    rdfs:label "female" ;
    skos:definition "Female." .

<https://w3id.org/alskg/schema/SexEnum#male> a owl:NamedIndividual, alskg:SexEnum ;
    rdfs:label "male" ;
    skos:definition "Male." .

<https://w3id.org/alskg/schema/SexEnum#mixed> a owl:NamedIndividual, alskg:SexEnum ;
    rdfs:label "mixed" ;
    skos:definition "Mixed or combined sex groups." .

<https://w3id.org/alskg/schema/SexEnum#unknown> a owl:NamedIndividual, alskg:SexEnum ;
    rdfs:label "unknown" ;
    skos:definition "Sex not reported or unknown." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#anatomical> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "anatomical" ;
    skos:definition "Subtype based on dominant anatomical system or region affected." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#clinical_onset> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "clinical_onset" ;
    skos:definition "Subtype based on site or pattern of clinical onset, such as bulbar-onset or limb-onset ALS." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#cognitive_behavioral> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "cognitive_behavioral" ;
    skos:definition "Subtype based on cognitive or behavioral features such as ALS-FTD." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#genetic> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "genetic" ;
    skos:definition "Subtype based on a gene, variant, repeat expansion, or inherited/genetic cause." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#model_system> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "model_system" ;
    skos:definition "Subtype or disease model defined in an experimental model system." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#molecular> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "molecular" ;
    skos:definition "Subtype derived from molecular data such as transcriptomics, proteomics, epigenomics, or multi-omics." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#motor_neuron_involvement> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "motor_neuron_involvement" ;
    skos:definition "Subtype based on upper and lower motor neuron involvement pattern." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#pathology> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "pathology" ;
    skos:definition "Subtype based on pathological findings such as TDP-43, SOD1, or FUS proteinopathy." .

<https://w3id.org/alskg/schema/SubtypeAxisEnum#progression> a owl:NamedIndividual, alskg:SubtypeAxisEnum ;
    rdfs:label "progression" ;
    skos:definition "Subtype based on progression speed, survival, or functional decline." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#clinical> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "clinical" ;
    skos:definition "Subtype defined by clinical presentation, site of onset, motor neuron involvement, or functional criteria. Examples: bulbar-onset ALS, upper-motor-neuron-predominant ALS, ALS-FTD." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#clinical_ml> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "clinical_ml" ;
    skos:definition "Subtype derived by machine learning applied to clinical variables such as ALSFRS-R trajectories, survival curves, symptom onset patterns, or neuroimaging features." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#epigenomic_ml> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "epigenomic_ml" ;
    skos:definition "Subtype derived by machine learning applied to methylation, chromatin accessibility, or other epigenomic data." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#genomic> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "genomic" ;
    skos:definition "Subtype defined by a specific causal or risk gene, sequence variant, or repeat expansion. Examples: SOD1-ALS, C9orf72-ALS, TARDBP-ALS, FUS-ALS." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#multiomics_ml> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "multiomics_ml" ;
    skos:definition "Subtype derived by machine learning integrating two or more omics data types (e.g. transcriptomics + proteomics + methylation). Use when no single omics layer is the primary driver." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#ontological> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "ontological" ;
    skos:definition "Subtype defined by position in a biomedical ontology (MONDO, EFO, ORDO). Examples: Familial ALS, Juvenile ALS, FTD/ALS spectrum nodes from OptimusKG." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#pathological> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "pathological" ;
    skos:definition "Subtype defined by neuropathological or proteinopathy findings. Examples: TDP-43 proteinopathy subtype, SOD1 aggregation pattern." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#proteomic_ml> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "proteomic_ml" ;
    skos:definition "Subtype derived by machine learning applied to protein abundance, post-translational modification, or pathway activation data." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#transcriptomic_ml> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "transcriptomic_ml" ;
    skos:definition "Subtype derived by unsupervised or supervised machine learning applied to bulk or single-cell RNA-seq data. Examples: ALS-Ox, ALS-Glia, ALS-TE from the NYGC ALS Consortium (Tam et al. 2019; DANCer, Cell Reports 2025)." .

<https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#unknown> a owl:NamedIndividual, alskg:SubtypeClassificationOriginEnum ;
    rdfs:label "unknown" ;
    skos:definition "Classification origin is not known or has not been recorded." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#copy_number_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "copy_number_variant" ;
    skos:definition "Copy number gain or loss." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#frameshift_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "frameshift_variant" ;
    skos:definition "Insertion/deletion that shifts the coding frame." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#missense_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "missense_variant" ;
    skos:definition "Variant causing an amino-acid substitution." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#noncoding_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "noncoding_variant" ;
    skos:definition "Variant located outside coding sequence." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#nonsense_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "nonsense_variant" ;
    skos:definition "Variant introducing a premature stop codon." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#repeat_expansion> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "repeat_expansion" ;
    skos:definition "Pathogenic or potentially pathogenic repeat expansion." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#splice_region_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "splice_region_variant" ;
    skos:definition "Variant affecting splice region or splicing." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#structural_variant> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "structural_variant" ;
    skos:definition "Larger deletion, duplication, inversion, insertion, or translocation." .

<https://w3id.org/alskg/schema/VariantConsequenceEnum#unknown> a owl:NamedIndividual, alskg:VariantConsequenceEnum ;
    rdfs:label "unknown" ;
    skos:definition "Consequence is not known." .

alskg:accession_numbers a owl:DatatypeProperty ;
    rdfs:label "accession_numbers" ;
    skos:definition "Database accession numbers from various sources" ;
    skos:inScheme alskg:alskg-schema .

alskg:affects_gene a owl:ObjectProperty ;
    rdfs:label "affects_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a sequence variant to a gene it affects." ;
    skos:inScheme alskg:alskg-schema .

alskg:alters_protein a owl:ObjectProperty ;
    rdfs:label "alters_protein" ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a sequence variant to a protein or protein product it alters." ;
    skos:inScheme alskg:alskg-schema .

alskg:aspect a owl:DatatypeProperty ;
    rdfs:label "aspect" ;
    skos:definition "HPO annotation aspect categories: \"P\" = Phenotypic abnormality, \"I\" = Mode of inheritance, \"C\" = Onset and clinical course, \"M\" = Clinical modifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:bio_curation a owl:DatatypeProperty ;
    rdfs:label "bio_curation" ;
    skos:definition "Biocuration provenance strings recording the curator ID and date (e.g. \"ORPHA:orphadata[2023-07-01]\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:biomarker_for_disease a owl:ObjectProperty ;
    rdfs:label "biomarker_for_disease" ;
    rdfs:range alskg:Disease ;
    skos:definition "Connects a biomarker to a disease it marks." ;
    skos:inScheme alskg:alskg-schema .

alskg:biomarker_for_subtype a owl:ObjectProperty ;
    rdfs:label "biomarker_for_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a biomarker to an ALS subtype it marks." ;
    skos:inScheme alskg:alskg-schema .

alskg:direct a owl:DatatypeProperty ;
    rdfs:label "direct" ;
    skos:definition "List of primary data source names that directly contributed this entity or relationship to OptimusKG (e.g. \"Open Targets\", \"DisGeNET\", \"Bgee\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:direct_sources a owl:DatatypeProperty ;
    rdfs:label "direct_sources" ;
    rdfs:range xsd:string ;
    skos:definition "Direct provenance sources contributing the node or edge, when available." ;
    skos:inScheme alskg:alskg-schema .

alskg:encodes a owl:ObjectProperty ;
    rdfs:label "encodes" ;
    rdfs:domain alskg:Gene ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a Gene to a Protein product. Used in the semantic view to normalize gene-associated protein identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:enrolls_subtype a owl:ObjectProperty ;
    rdfs:label "enrolls_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a clinical trial to an enrolled or targeted ALS subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    skos:definition "Phenotype frequency annotations. May be ontology terms (HP:0040283 = Occasional) or percentage ranges (e.g. \"5-29%\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_als_subtype a owl:ObjectProperty ;
    rdfs:label "has_als_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects ALS disease to an ALS subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_cell_type a owl:ObjectProperty ;
    rdfs:label "has_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a sample or context to its cell type." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_database_accession a owl:ObjectProperty ;
    rdfs:label "has_database_accession" ;
    rdfs:range alskg:DatabaseAccession ;
    skos:definition "Connects a semantic entity to a database-specific accession node." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_evidence_basis a owl:ObjectProperty ;
    rdfs:label "has_evidence_basis" ;
    rdfs:range alskg:EvidenceStatement ;
    skos:definition "Connects a hypothesis to evidence statements used as its rationale." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_evidence_record a owl:ObjectProperty ;
    rdfs:label "has_evidence_record" ;
    rdfs:range alskg:EvidenceRecord ;
    skos:definition "Connects a relationship or semantic statement to structured supporting evidence." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_genetic_perturbation a owl:ObjectProperty ;
    rdfs:label "has_genetic_perturbation" ;
    rdfs:range alskg:NamedEntity ;
    skos:definition "Connects a model system to a gene, variant, or perturbation used in the model." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_isoform a owl:ObjectProperty ;
    rdfs:label "has_isoform" ;
    rdfs:domain alskg:Protein ;
    rdfs:range alskg:ProteinIsoform ;
    skos:definition "Connects a Protein to a more specific ProteinIsoform." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_outcome_measure a owl:ObjectProperty ;
    rdfs:label "has_outcome_measure" ;
    rdfs:range alskg:NamedEntity ;
    skos:definition "Connects a clinical trial to an outcome measure or endpoint." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_protein_component a owl:ObjectProperty ;
    rdfs:label "has_protein_component" ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a protein aggregate to the protein components present in the aggregate." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_subtype_criterion a owl:ObjectProperty ;
    rdfs:label "has_subtype_criterion" ;
    rdfs:range alskg:SubtypeCriterion ;
    skos:definition "Connects a subtype to a criterion used to define or assign it." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_subtype_scheme a owl:ObjectProperty ;
    rdfs:label "has_subtype_scheme" ;
    rdfs:range alskg:SubtypeScheme ;
    skos:definition "Connects a subtype to the scheme under which it is defined or assigned." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_variant a owl:ObjectProperty ;
    rdfs:label "has_variant" ;
    rdfs:range alskg:SequenceVariant ;
    skos:definition "Connects a gene to a sequence variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:indicates_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "indicates_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a biomarker to a pathogenic mechanism it indicates." ;
    skos:inScheme alskg:alskg-schema .

alskg:indirect a owl:DatatypeProperty ;
    rdfs:label "indirect" ;
    skos:definition "List of upstream data sources referenced via provenance of primary sources (e.g. \"ClinGen\", \"PsyGeNET\", \"UniProt\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:indirect_sources a owl:DatatypeProperty ;
    rdfs:label "indirect_sources" ;
    rdfs:range xsd:string ;
    skos:definition "Indirect upstream sources referenced by contributing resources, when available." ;
    skos:inScheme alskg:alskg-schema .

alskg:involves_biological_process a owl:ObjectProperty ;
    rdfs:label "involves_biological_process" ;
    rdfs:range alskg:BiologicalProcess ;
    skos:definition "Connects a pathogenic mechanism to a biological process it involves." ;
    skos:inScheme alskg:alskg-schema .

alskg:involves_molecular_function a owl:ObjectProperty ;
    rdfs:label "involves_molecular_function" ;
    rdfs:range alskg:MolecularFunction ;
    skos:definition "Connects a pathogenic mechanism to a molecular function it involves." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_defined_by_gene a owl:ObjectProperty ;
    rdfs:label "is_defined_by_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects an ALS subtype to a defining or characteristic gene." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_defined_by_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "is_defined_by_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects an ALS subtype to a defining pathogenic mechanism." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_defined_by_variant a owl:ObjectProperty ;
    rdfs:label "is_defined_by_variant" ;
    rdfs:range alskg:SequenceVariant ;
    skos:definition "Connects an ALS subtype to a defining or characteristic variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:key_pathways a owl:DatatypeProperty ;
    rdfs:label "key_pathways" ;
    skos:definition "Key biological pathways or gene sets enriched in this subtype (e.g. \"Interferon-alpha signaling\", \"Oxidative phosphorylation\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:mechanisms_of_action a owl:DatatypeProperty ;
    rdfs:label "mechanisms_of_action" ;
    skos:definition "Free-text descriptions of the biochemical or pharmacological mechanism of action for this drug-gene interaction (e.g. \"Competitive inhibitor\", \"Irreversible inhibitor\", \"Partial agonist\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:modifiers a owl:DatatypeProperty ;
    rdfs:label "modifiers" ;
    skos:definition "Clinical modifier HPO terms (e.g. severity, progression)" ;
    skos:inScheme alskg:alskg-schema .

alskg:onset a owl:DatatypeProperty ;
    rdfs:label "onset" ;
    skos:definition "Age of onset categories (HPO terms, e.g. \"HP:0003577\" = Congenital onset)" ;
    skos:inScheme alskg:alskg-schema .

alskg:references a owl:DatatypeProperty ;
    rdfs:label "references" ;
    skos:definition "Supporting publication PMIDs or database references (e.g. \"PMID:1234567\")" ;
    skos:inScheme alskg:alskg-schema .

alskg:sexes a owl:DatatypeProperty ;
    rdfs:label "sexes" ;
    skos:definition "Sex-specific occurrence annotations (e.g. \"PATO:0000384\" = male)" ;
    skos:inScheme alskg:alskg-schema .

alskg:source_categories a owl:DatatypeProperty ;
    rdfs:label "source_categories" ;
    skos:definition "Categories describing the origin or context of the exposure (e.g. \"chemical\", \"biological\", \"physical\", \"dietary\", \"lifestyle\")" ;
    skos:inScheme alskg:alskg-schema .

alskg:source_urls a owl:DatatypeProperty ;
    rdfs:label "source_urls" ;
    skos:definition "URLs linking to supporting evidence records in source databases" ;
    skos:inScheme alskg:alskg-schema .

alskg:tested_in_clinical_trial a owl:ObjectProperty ;
    rdfs:label "tested_in_clinical_trial" ;
    rdfs:range alskg:ClinicalTrial ;
    skos:definition "Connects a therapy or intervention to a clinical trial that tests it." ;
    skos:inScheme alskg:alskg-schema .

alskg:tests_intervention a owl:ObjectProperty ;
    rdfs:label "tests_intervention" ;
    rdfs:range alskg:TherapeuticIntervention ;
    skos:definition "Connects a clinical trial to the intervention it tests." ;
    skos:inScheme alskg:alskg-schema .

alskg:therapeutic_areas a owl:DatatypeProperty ;
    rdfs:label "therapeutic_areas" ;
    skos:definition "Associated therapeutic area classification codes (Open Targets EFO)" ;
    skos:inScheme alskg:alskg-schema .

alskg:tissue_origin a owl:DatatypeProperty ;
    rdfs:label "tissue_origin" ;
    skos:definition "Tissues or biological contexts in which this subtype was characterized (e.g. \"motor cortex\", \"spinal cord\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:trade_names a owl:DatatypeProperty ;
    rdfs:label "trade_names" ;
    skos:definition "Commercial brand/trade names (e.g. \"Glucophage\" for metformin)" ;
    skos:inScheme alskg:alskg-schema .

alskg:validated_in a owl:DatatypeProperty ;
    rdfs:label "validated_in" ;
    skos:definition "Independent studies in which this expression finding has been replicated or cross-validated (e.g. \"Catanese_2023\", \"Ho_2021\", \"Humphrey_2022\", \"Ziff_2023\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:ComparatorGroup a owl:Class ;
    rdfs:label "ComparatorGroup" ;
    rdfs:subClassOf alskg:Cohort ;
    skos:definition "A comparator group used in differential expression, biomarker, or clinical analyses, such as control, non-ALS, sporadic ALS, C9orf72-ALS, or healthy motor neuron group." ;
    skos:exactMatch alskg:ComparatorGroup ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "CMP" .

alskg:DrugDiseaseTherapeuticRelationship a owl:Class ;
    rdfs:label "DrugDiseaseTherapeuticRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:reference_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:drug_disease_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:reference_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:drug_disease_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:drug_disease_id ],
        alskg:PharmacologicalRelationship ;
    skos:definition """Parent class for drug-to-disease therapeutic-use relationships, including indication, contraindication, and off-label use.

Property detail: Drug-disease therapeutic associations including indications, contraindications, and off-label uses. Relations: INDICATION, CONTRAINDICATION, OFF_LABEL_USE. Undirected: True. Count: 70,380. Sources: DrugCentral, Open Targets. Indirect: ATC, Clinical Trials, DailyMed, EMA, FDA, INN, USAN.""" ;
    skos:exactMatch okg:DrugDiseaseTherapeuticRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:DrugGeneRelationship a owl:Class ;
    rdfs:label "DrugGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:source_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:mechanisms_of_action ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source_urls ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:mechanisms_of_action ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty alskg:source_urls ],
        alskg:AssociationRelationship ;
    skos:definition """Parent class for all OptimusKG relationships between Drug and Gene nodes. This groups target, modulation, transporter, enzyme, carrier, and other pharmacologic relationship types.

Property detail: Drug-target interactions with pharmacological mechanism annotations. Relations: 23 types including ACTIVATOR, AGONIST, ANTAGONIST, INHIBITOR, TARGET, SUBSTRATE, CARRIER, TRANSPORTER, ENZYME, etc. Undirected: False. Count: 20,694. Sources: DrugBank, Open Targets. Indirect: BNF, Clinical Trials, DOI, DailyMed, EMA, Expert, FDA, HMA, ISBN, IUPHAR, KEGG, Other, PMC, Patent, PubChem, PubMed, UniProt, Wikipedia.""" ;
    skos:exactMatch okg:DrugGeneRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:DrugGeneRoleRelationship a owl:Class ;
    rdfs:label "DrugGeneRoleRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        alskg:DrugGeneRelationship ;
    skos:definition "Drug-gene relationship describing the role of a gene product in drug metabolism, transport, or carrier behavior." ;
    skos:exactMatch okg:DrugGeneRoleRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:DrugGeneTargetingRelationship a owl:Class ;
    rdfs:label "DrugGeneTargetingRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        alskg:DrugGeneRelationship ;
    skos:definition "Drug-gene relationship indicating target designation, target binding, substrate status, or direct drug-target association." ;
    skos:exactMatch okg:DrugGeneTargetingRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ExpressionCallQualityEnum a owl:Class ;
    rdfs:label "ExpressionCallQualityEnum" ;
    skos:definition "Bgee expression call quality levels for ANA-GEN edges. Reflects confidence in gene expression calls derived from curated RNA-seq data." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/ExpressionCallQualityEnum#gold>,
        <https://w3id.org/alskg/schema/ExpressionCallQualityEnum#silver> .

alskg:ModelSystem a owl:Class ;
    rdfs:label "ModelSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:models_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_genetic_perturbation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:model_system_models_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:models_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:models_disease ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:NamedEntity ;
            owl:onProperty alskg:has_genetic_perturbation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:model_system_models_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:model_system_models_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:models_subtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:models_disease ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:models_disease ],
        alskg:AnalyticalEntity ;
    skos:definition "A biological model system used to study ALS, including animal models, iPSC-derived cells, organoids, cell lines, or perturbation systems." ;
    skos:exactMatch alskg:ModelSystem ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "MOD" .

alskg:MolecularEvent a owl:Class ;
    rdfs:label "MolecularEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicMechanism ;
            owl:onProperty alskg:contributes_to_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:contributes_to_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        alskg:AnalyticalEntity ;
    skos:definition "A specific molecular event involved in ALS pathogenesis, such as TDP-43 nuclear depletion, cytoplasmic aggregation, altered splicing, repeat RNA foci formation, DPR protein accumulation, mitochondrial complex dysregulation, or complement activation." ;
    skos:exactMatch alskg:MolecularEvent ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "MEV" .

alskg:OntologyMetadata a owl:Class ;
    rdfs:label "OntologyMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:title ],
        alskg:ProvenanceEntity ;
    skos:definition "Metadata about the source ontology for a node. Captured verbatim from the OWL or JSON ontology file header at ingestion time." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:source_schema "optimuskg_schema.yaml" .

alskg:PharmacologicalRelationship a owl:Class ;
    rdfs:label "PharmacologicalRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        alskg:RelationshipAssertion ;
    skos:definition "Abstract family for drug therapeutic-use relationships, including indication, contraindication, off-label use, and adverse drug reactions. Subject is always a Drug node. Renamed from TherapeuticUseRelationship (v0.3.0) to reflect that this family covers all drug action semantics, not only clinical therapeutic use." ;
    skos:exactMatch okg:PharmacologicalRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ProgressionPattern a owl:Class ;
    rdfs:label "ProgressionPattern" ;
    rdfs:subClassOf alskg:ClinicalEntity ;
    skos:definition "A disease progression pattern such as fast progression, slow progression, respiratory progression, spreading pattern, or ALSFRS-R decline trajectory." ;
    skos:exactMatch alskg:ProgressionPattern ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "PRG" .

alskg:ProteinIsoform a owl:Class ;
    rdfs:label "ProteinIsoform" ;
    rdfs:subClassOf alskg:Protein ;
    skos:definition "A specific protein isoform or translated product, for example an Ensembl protein accession that may represent a transcript-specific protein product." ;
    skos:exactMatch alskg:ProteinIsoform ;
    skos:inScheme alskg:alskg-schema .

alskg:TherapeuticIntervention a owl:Class ;
    rdfs:label "TherapeuticIntervention" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:tested_in_clinical_trial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:therapeutic_intervention_tested_in_clinical_trial ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ClinicalTrial ;
            owl:onProperty alskg:tested_in_clinical_trial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:targets_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:therapeutic_intervention_tested_in_clinical_trial ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ClinicalTrial ;
            owl:onProperty alskg:therapeutic_intervention_tested_in_clinical_trial ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicMechanism ;
            owl:onProperty alskg:modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:targets_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Protein ;
            owl:onProperty alskg:targets_protein ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:targets_protein ],
        alskg:ClinicalEntity ;
    skos:definition "A therapeutic intervention relevant to ALS, including small molecules, antisense oligonucleotides, gene therapy, biologics, rehabilitation, respiratory support, or investigational therapies." ;
    skos:exactMatch biolink:Treatment ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "TX" .

alskg:accession a owl:DatatypeProperty ;
    rdfs:label "accession" ;
    rdfs:range xsd:string ;
    skos:definition "The local accession string within a source database, for example P40261 or ENSP00000299964." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_affects_anatomy a owl:ObjectProperty ;
    rdfs:label "als_subtype_affects_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects an ALS subtype to an affected anatomical structure." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_defined_by_gene a owl:ObjectProperty ;
    rdfs:label "als_subtype_defined_by_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects an ALS subtype to a defining or characteristic gene." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_defined_by_variant a owl:ObjectProperty ;
    rdfs:label "als_subtype_defined_by_variant" ;
    rdfs:range alskg:SequenceVariant ;
    skos:definition "Connects an ALS subtype to a defining or characteristic variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_has_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "als_subtype_has_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects an ALS subtype to a pathogenic mechanism implicated in that subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_has_phenotype_observation a owl:ObjectProperty ;
    rdfs:label "als_subtype_has_phenotype_observation" ;
    rdfs:range alskg:PhenotypeObservation ;
    skos:definition "Connects an ALS subtype to a contextual phenotype observation." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_has_subtype_criterion a owl:ObjectProperty ;
    rdfs:label "als_subtype_has_subtype_criterion" ;
    rdfs:range alskg:SubtypeCriterion ;
    skos:definition "Connects an ALS subtype to a defining or assignment criterion." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_has_subtype_scheme a owl:ObjectProperty ;
    rdfs:label "als_subtype_has_subtype_scheme" ;
    rdfs:range alskg:SubtypeScheme ;
    skos:definition "Connects an ALS subtype to its subtype scheme or taxonomy." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_involves_cell_type a owl:ObjectProperty ;
    rdfs:label "als_subtype_involves_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects an ALS subtype to a relevant or affected cell type." ;
    skos:inScheme alskg:alskg-schema .

alskg:als_subtype_is_subtype_of_disease a owl:ObjectProperty ;
    rdfs:label "als_subtype_is_subtype_of_disease" ;
    rdfs:range alskg:Disease ;
    skos:definition "Subtype-to-disease relationship meaning the ALS subtype is a subtype of the disease." ;
    skos:inScheme alskg:alskg-schema .

alskg:anatomy a owl:ObjectProperty ;
    rdfs:label "anatomy" ;
    skos:definition "The tissue or anatomical region in which the expression was measured (e.g. motor cortex, spinal cord). Null when the context is an iPSC cell model without a corresponding anatomy node." ;
    skos:inScheme alskg:alskg-schema .

alskg:biological_context_type a owl:ObjectProperty ;
    rdfs:label "biological_context_type" ;
    skos:definition "Type of biological context in which the expression was measured (e.g. postmortem_cortex, postmortem_cord, C9orf72_motor_neuron)." ;
    skos:inScheme alskg:alskg-schema .

alskg:biological_note a owl:DatatypeProperty ;
    rdfs:label "biological_note" ;
    skos:definition "Optional free-text note contextualizing the biological significance of this expression finding." ;
    skos:inScheme alskg:alskg-schema .

alskg:biotype a owl:ObjectProperty ;
    rdfs:label "biotype" ;
    skos:definition "Ensembl gene biotype classification (e.g. protein_coding, lncRNA, miRNA). Determines the functional class of the gene product." ;
    skos:inScheme alskg:alskg-schema .

alskg:black_box_warning a owl:DatatypeProperty ;
    rdfs:label "black_box_warning" ;
    skos:definition "True if the drug carries an FDA black box (boxed) warning" ;
    skos:inScheme alskg:alskg-schema .

alskg:call_quality a owl:ObjectProperty ;
    rdfs:label "call_quality" ;
    skos:definition "Quality level of the Bgee expression call (gold = high confidence, silver = moderate confidence). Based on concordance across evidence types." ;
    skos:inScheme alskg:alskg-schema .

alskg:cd_formula a owl:DatatypeProperty ;
    rdfs:label "cd_formula" ;
    skos:definition "Molecular formula (e.g. \"C10H17N3O6S\")" ;
    skos:inScheme alskg:alskg-schema .

alskg:cell_model a owl:DatatypeProperty ;
    rdfs:label "cell_model" ;
    skos:definition "Specific iPSC cell model identifier when the context is a cell model rather than postmortem tissue (e.g. \"C9orf72_motor_neuron\", \"FUS_motor_neuron\", \"TDP43_motor_neuron\"). Null for postmortem tissue." ;
    skos:inScheme alskg:alskg-schema .

alskg:chemical_abstracts_service_number a owl:DatatypeProperty ;
    rdfs:label "chemical_abstracts_service_number" ;
    skos:definition "CAS Registry Number — the gold-standard chemical compound identifier from the American Chemical Society (e.g. \"57-27-2\" for morphine)." ;
    skos:inScheme alskg:alskg-schema .

alskg:classification_basis a owl:ObjectProperty ;
    rdfs:label "classification_basis" ;
    skos:definition "Computational basis used to define and assign membership in this subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:classification_origin a owl:ObjectProperty ;
    rdfs:label "classification_origin" ;
    skos:definition "How this ALS subtype was derived or defined. Distinguishes clinically or ontologically grounded subtypes from those produced by machine learning on omics data. Use transcriptomic_ml, proteomic_ml, epigenomic_ml, or multiomics_ml for computationally derived subtypes such as ALS-Ox, ALS-Glia, and ALS-TE. Use genomic for gene-defined subtypes (SOD1-ALS, C9orf72-ALS). Use clinical for onset-based or functional subtypes. Defaults to unknown when not recorded." ;
    skos:inScheme alskg:alskg-schema .

alskg:clinical_trial_enrolls_subtype a owl:ObjectProperty ;
    rdfs:label "clinical_trial_enrolls_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a clinical trial to an ALS subtype that it enrolls or targets." ;
    skos:inScheme alskg:alskg-schema .

alskg:cohort a owl:DatatypeProperty ;
    rdfs:label "cohort" ;
    skos:definition "Patient cohort in which this subtype was defined (e.g. \"NYGC_ALS_Consortium_postmortem_cortex\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:compares_against a owl:ObjectProperty ;
    rdfs:label "compares_against" ;
    rdfs:range alskg:ComparatorGroup ;
    skos:definition "Connects a result to the comparator group or condition used in the analysis." ;
    skos:inScheme alskg:alskg-schema .

alskg:computational_method a owl:DatatypeProperty ;
    rdfs:label "computational_method" ;
    skos:definition "Specific computational or machine learning method used to derive this molecular subtype. Record the algorithm or model name and version where available. Examples: \"k-means (k=3, postmortem cortex transcriptomes)\", \"NMF rank-3 factorization\", \"DANCer deep multi-omics classifier v1.0 (Cell Reports 2025)\", \"scVI + Leiden clustering (resolution 0.4)\". Leave null for clinically or ontologically defined subtypes." ;
    skos:inScheme alskg:alskg-schema .

alskg:defining_mechanism a owl:DatatypeProperty ;
    rdfs:label "defining_mechanism" ;
    skos:definition "Primary biological mechanism or pathway that defines this subtype (e.g. \"Oxidative phosphorylation dysregulation and proteotoxic stress\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:derived_from_anatomy a owl:ObjectProperty ;
    rdfs:label "derived_from_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a sample to the anatomy from which it was derived." ;
    skos:inScheme alskg:alskg-schema .

alskg:derives_from_dataset a owl:ObjectProperty ;
    rdfs:label "derives_from_dataset" ;
    rdfs:range alskg:Dataset ;
    skos:definition "Connects a result or statement to the dataset from which it was derived." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_derives_from_dataset a owl:ObjectProperty ;
    rdfs:label "differential_expression_derives_from_dataset" ;
    rdfs:range alskg:Dataset ;
    skos:definition "Connects a differential expression result to the dataset from which it was derived." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_measured_by_assay a owl:ObjectProperty ;
    rdfs:label "differential_expression_measured_by_assay" ;
    rdfs:range alskg:Assay ;
    skos:definition "Connects a differential expression result to the assay that measured it." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_measures_gene a owl:ObjectProperty ;
    rdfs:label "differential_expression_measures_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a differential expression statement to the gene measured." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_occurs_in_anatomy a owl:ObjectProperty ;
    rdfs:label "differential_expression_occurs_in_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a differential expression result to its anatomical context." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_occurs_in_cell_type a owl:ObjectProperty ;
    rdfs:label "differential_expression_occurs_in_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a differential expression result to its cell type context." ;
    skos:inScheme alskg:alskg-schema .

alskg:differential_expression_occurs_in_subtype a owl:ObjectProperty ;
    rdfs:label "differential_expression_occurs_in_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a differential expression result to its ALS subtype context." ;
    skos:inScheme alskg:alskg-schema .

alskg:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    skos:definition "Direction of differential expression relative to non-ALS controls. UP = upregulated; DOWN = downregulated in this molecular subtype and biological context." ;
    skos:inScheme alskg:alskg-schema .

alskg:disease_has_als_subtype a owl:ObjectProperty ;
    rdfs:label "disease_has_als_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Disease-to-subtype relationship meaning the disease has the ALS subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:disease_has_molecular_subtype a owl:ObjectProperty ;
    rdfs:label "disease_has_molecular_subtype" ;
    rdfs:domain alskg:Disease ;
    rdfs:range alskg:MolecularSubtype ;
    skos:definition "Current OptimusKG Neo4j relationship `HAS_MOLECULAR_SUBTYPE` from `DIS`/Disease to `MST`/MolecularSubtype. Indicates that a disease node is associated with a transcriptome-derived molecular subtype. Orthogonal to the ontological disease hierarchy; represents a classification layer derived from unsupervised multi-omic clustering." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "MST" ;
    alskg:neo4j_relationship_type "HAS_MOLECULAR_SUBTYPE" ;
    alskg:neo4j_start_label "DIS" .

alskg:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    rdfs:range xsd:string ;
    skos:definition "Digital Object Identifier for a publication." ;
    skos:inScheme alskg:alskg-schema .

alskg:drug_repurposing_hypothesis_modulates_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "drug_repurposing_hypothesis_modulates_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a drug repurposing hypothesis to a pathogenic mechanism it proposes to modulate." ;
    skos:inScheme alskg:alskg-schema .

alskg:drug_repurposing_hypothesis_prioritizes_drug a owl:ObjectProperty ;
    rdfs:label "drug_repurposing_hypothesis_prioritizes_drug" ;
    rdfs:range alskg:Drug ;
    skos:definition "Connects a drug repurposing hypothesis to the candidate drug being prioritized." ;
    skos:inScheme alskg:alskg-schema .

alskg:drug_repurposing_hypothesis_targets_gene a owl:ObjectProperty ;
    rdfs:label "drug_repurposing_hypothesis_targets_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a drug repurposing hypothesis to an implicated target gene." ;
    skos:inScheme alskg:alskg-schema .

alskg:evidence_statement_derives_from_dataset a owl:ObjectProperty ;
    rdfs:label "evidence_statement_derives_from_dataset" ;
    rdfs:range alskg:Dataset ;
    skos:definition "Connects an evidence statement to the dataset from which it was derived." ;
    skos:inScheme alskg:alskg-schema .

alskg:evidence_statement_supported_by_evidence a owl:ObjectProperty ;
    rdfs:label "evidence_statement_supported_by_evidence" ;
    rdfs:range alskg:EvidenceRecord ;
    skos:definition "Connects an evidence statement to supporting evidence." ;
    skos:inScheme alskg:alskg-schema .

alskg:expected_subtype_count a owl:DatatypeProperty ;
    rdfs:label "expected_subtype_count" ;
    skos:definition "Number of distinct subtypes identified in the defining study or analysis run (e.g. 3 for ALS-Ox/Glia/TE, or the k chosen for a k-means run). Useful for tracking how the subtype landscape expands as new ML analyses are added." ;
    skos:inScheme alskg:alskg-schema .

alskg:expression_rank a owl:DatatypeProperty ;
    rdfs:label "expression_rank" ;
    skos:definition "Bgee expression rank score for this gene in this tissue. Lower rank = higher relative expression. Computed across all tissues." ;
    skos:inScheme alskg:alskg-schema .

alskg:full_name a owl:DatatypeProperty ;
    rdfs:label "full_name" ;
    skos:definition "Full descriptive name of the molecular subtype (e.g. \"ALS Oxidative Stress / Mitochondrial Dysfunction subtype\")." ;
    skos:inScheme alskg:alskg-schema .

alskg:gene a owl:ObjectProperty ;
    rdfs:label "gene" ;
    skos:definition "The gene or genomic feature whose expression is described by this context." ;
    skos:inScheme alskg:alskg-schema .

alskg:gene_contributes_to_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "gene_contributes_to_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a gene to an ALS pathogenic mechanism it contributes to." ;
    skos:inScheme alskg:alskg-schema .

alskg:gene_has_expression_context a owl:ObjectProperty ;
    rdfs:label "gene_has_expression_context" ;
    rdfs:domain alskg:Gene ;
    rdfs:range alskg:GeneExpressionContext ;
    skos:definition "Neo4j relationship `HAS_EXPRESSION_CONTEXT` from `GEN`/Gene to `ECX`/GeneExpressionContext. Links a gene to a reified expression context node capturing direction, molecular subtype, tissue, and provenance." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "ECX" ;
    alskg:neo4j_relationship_type "HAS_EXPRESSION_CONTEXT" ;
    alskg:neo4j_start_label "GEN" .

alskg:gene_has_variant a owl:ObjectProperty ;
    rdfs:label "gene_has_variant" ;
    rdfs:range alskg:SequenceVariant ;
    skos:definition "Connects a gene to a sequence variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_abundance_direction a owl:ObjectProperty ;
    rdfs:label "has_abundance_direction" ;
    rdfs:range alskg:ExpressionDirectionEnum ;
    skos:definition "Direction of protein abundance change relative to comparator." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_adjusted_p_value a owl:DatatypeProperty ;
    rdfs:label "has_adjusted_p_value" ;
    rdfs:range xsd:float ;
    skos:definition "Multiple-testing-adjusted p-value for a statistical result." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_been_withdrawn a owl:DatatypeProperty ;
    rdfs:label "has_been_withdrawn" ;
    skos:definition "True if the drug has been withdrawn from the market" ;
    skos:inScheme alskg:alskg-schema .

alskg:has_disease_stage a owl:ObjectProperty ;
    rdfs:label "has_disease_stage" ;
    rdfs:range alskg:DiseaseStage ;
    skos:definition "Connects an observation to a disease stage." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_expression_direction a owl:ObjectProperty ;
    rdfs:label "has_expression_direction" ;
    rdfs:range alskg:ExpressionDirectionEnum ;
    skos:definition "Direction of differential expression relative to a comparator." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_false_discovery_rate a owl:DatatypeProperty ;
    rdfs:label "has_false_discovery_rate" ;
    rdfs:range xsd:float ;
    skos:definition "False discovery rate for a statistical result." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_log_fold_change a owl:DatatypeProperty ;
    rdfs:label "has_log_fold_change" ;
    rdfs:range xsd:float ;
    skos:definition "Log fold-change value for a differential expression result." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_observed_phenotype a owl:ObjectProperty ;
    rdfs:label "has_observed_phenotype" ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Connects a phenotype observation to the phenotype observed." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_p_value a owl:DatatypeProperty ;
    rdfs:label "has_p_value" ;
    rdfs:range xsd:float ;
    skos:definition "Nominal p-value for a statistical result." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_pathogenic_mechanism_category a owl:ObjectProperty ;
    rdfs:label "has_pathogenic_mechanism_category" ;
    rdfs:range alskg:PathogenicMechanismEnum ;
    skos:definition "Categorizes a pathogenic mechanism using a controlled ALS mechanism category." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_pathogenicity a owl:ObjectProperty ;
    rdfs:label "has_pathogenicity" ;
    rdfs:range alskg:PathogenicityEnum ;
    skos:definition "Clinical or biological pathogenicity classification of a variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_progression_pattern a owl:ObjectProperty ;
    rdfs:label "has_progression_pattern" ;
    rdfs:range alskg:ProgressionPattern ;
    skos:definition "Connects an observation, subtype, or disease to a progression pattern." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_variant_type a owl:DatatypeProperty ;
    rdfs:label "has_variant_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of sequence variant, preferably represented with a Sequence Ontology term." ;
    skos:inScheme alskg:alskg-schema .

alskg:inchi_key a owl:DatatypeProperty ;
    rdfs:label "inchi_key" ;
    skos:definition "Hashed InChIKey identifier (27-character string). Standard chemical structure fingerprint for deduplication and lookup." ;
    skos:inScheme alskg:alskg-schema .

alskg:interaction_description a owl:DatatypeProperty ;
    rdfs:label "interaction_description" ;
    skos:definition "Free-text description of the drug-drug interaction mechanism, clinical significance, or severity (from DrugBank DDI annotations)." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_approved a owl:DatatypeProperty ;
    rdfs:label "is_approved" ;
    skos:definition "True if the drug is currently approved for clinical use in any jurisdiction" ;
    skos:inScheme alskg:alskg-schema .

alskg:is_subtype_of a owl:ObjectProperty ;
    rdfs:label "is_subtype_of" ;
    rdfs:range alskg:Disease ;
    skos:definition "Connects an ALS subtype to the disease it subtypes, usually amyotrophic lateral sclerosis." ;
    skos:inScheme alskg:alskg-schema .

alskg:label_color a owl:DatatypeProperty ;
    rdfs:label "label_color" ;
    skos:definition "Display color used in the original publication's visualizations (e.g. \"blue\" for ALS-Ox, \"gold\" for ALS-Glia, \"red\" for ALS-TE). Informational only." ;
    skos:inScheme alskg:alskg-schema .

alskg:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:definition "License under which the ontology is distributed (e.g. \"CC BY 4.0\")" ;
    skos:inScheme alskg:alskg-schema .

alskg:maximum_clinical_trial_phase a owl:DatatypeProperty ;
    rdfs:label "maximum_clinical_trial_phase" ;
    skos:definition "Highest clinical trial phase the drug has reached (0–4). 4 = marketed/approved, 0 = preclinical/experimental." ;
    skos:inScheme alskg:alskg-schema .

alskg:measures_gene_expression_of a owl:ObjectProperty ;
    rdfs:label "measures_gene_expression_of" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a differential expression result to the gene whose expression is measured." ;
    skos:inScheme alskg:alskg-schema .

alskg:measures_protein_abundance_of a owl:ObjectProperty ;
    rdfs:label "measures_protein_abundance_of" ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a protein abundance result to the protein measured." ;
    skos:inScheme alskg:alskg-schema .

alskg:model_system_models_subtype a owl:ObjectProperty ;
    rdfs:label "model_system_models_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a model system to the ALS subtype it models." ;
    skos:inScheme alskg:alskg-schema .

alskg:models_disease a owl:ObjectProperty ;
    rdfs:label "models_disease" ;
    rdfs:range alskg:Disease ;
    skos:definition "Connects a model system to the disease it models." ;
    skos:inScheme alskg:alskg-schema .

alskg:models_subtype a owl:ObjectProperty ;
    rdfs:label "models_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a model system to the ALS subtype it models." ;
    skos:inScheme alskg:alskg-schema .

alskg:molecular_subtype a owl:ObjectProperty ;
    rdfs:label "molecular_subtype" ;
    skos:definition "The molecular disease subtype in which the gene is differentially expressed (e.g. ALS-Ox, ALS-Glia, ALS-TE)." ;
    skos:inScheme alskg:alskg-schema .

alskg:occurs_in_cohort a owl:ObjectProperty ;
    rdfs:label "occurs_in_cohort" ;
    rdfs:range alskg:Cohort ;
    skos:definition "Connects a statement, result, or observation to a cohort in which it was observed." ;
    skos:inScheme alskg:alskg-schema .

alskg:onset_age_mean a owl:DatatypeProperty ;
    rdfs:label "onset_age_mean" ;
    skos:definition "Mean age of disease onset (years) for patients assigned to this molecular subtype, where available." ;
    skos:inScheme alskg:alskg-schema .

alskg:pathogenic_mechanism_occurs_in_anatomy a owl:ObjectProperty ;
    rdfs:label "pathogenic_mechanism_occurs_in_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a pathogenic mechanism to the anatomy where it occurs." ;
    skos:inScheme alskg:alskg-schema .

alskg:pathogenic_mechanism_occurs_in_cell_type a owl:ObjectProperty ;
    rdfs:label "pathogenic_mechanism_occurs_in_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a pathogenic mechanism to the cell type where it occurs." ;
    skos:inScheme alskg:alskg-schema .

alskg:phenotype_observation_has_observed_phenotype a owl:ObjectProperty ;
    rdfs:label "phenotype_observation_has_observed_phenotype" ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Connects a phenotype observation to the phenotype observed." ;
    skos:inScheme alskg:alskg-schema .

alskg:phenotype_observation_occurs_in_subtype a owl:ObjectProperty ;
    rdfs:label "phenotype_observation_occurs_in_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a phenotype observation to its subtype context." ;
    skos:inScheme alskg:alskg-schema .

alskg:pmid a owl:DatatypeProperty ;
    rdfs:label "pmid" ;
    rdfs:range xsd:string ;
    skos:definition "PubMed identifier for a publication." ;
    skos:inScheme alskg:alskg-schema .

alskg:prevalence_pct a owl:DatatypeProperty ;
    rdfs:label "prevalence_pct" ;
    skos:definition "Estimated prevalence of this subtype as a percentage of ALS patient postmortem samples in the defining cohort." ;
    skos:inScheme alskg:alskg-schema .

alskg:prioritizes_drug a owl:ObjectProperty ;
    rdfs:label "prioritizes_drug" ;
    rdfs:range alskg:Drug ;
    skos:definition "Connects a drug repurposing hypothesis to the candidate drug being prioritized." ;
    skos:inScheme alskg:alskg-schema .

alskg:prognosis_note a owl:DatatypeProperty ;
    rdfs:label "prognosis_note" ;
    skos:definition "Free-text summary of prognostic differences associated with this molecular subtype relative to others." ;
    skos:inScheme alskg:alskg-schema .

alskg:pubmed_id a owl:DatatypeProperty ;
    rdfs:label "pubmed_id" ;
    skos:definition "PubMed identifier of the primary publication defining this molecular subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:qualifier_not a owl:DatatypeProperty ;
    rdfs:label "qualifier_not" ;
    skos:definition "True if this is an exclusion annotation — the phenotype is explicitly absent/excluded in this disease context." ;
    skos:inScheme alskg:alskg-schema .

alskg:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "Source string or compact source identifier, when available." ;
    skos:inScheme alskg:alskg-schema .

alskg:source_details a owl:DatatypeProperty ;
    rdfs:label "source_details" ;
    skos:definition "Free-text description providing additional source-specific context for the exposure (e.g. specific exposure routes, measurement context)" ;
    skos:inScheme alskg:alskg-schema .

alskg:source_type a owl:DatatypeProperty ;
    rdfs:label "source_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of source, for example ontology, database, literature corpus, aggregator, or computed dataset." ;
    skos:inScheme alskg:alskg-schema .

alskg:species a owl:DatatypeProperty ;
    rdfs:label "species" ;
    skos:definition "Species name for the pathway (always \"Homo sapiens\" in OptimusKG, as the pipeline filters to human pathways only)" ;
    skos:inScheme alskg:alskg-schema .

alskg:survival_months_median a owl:DatatypeProperty ;
    rdfs:label "survival_months_median" ;
    skos:definition "Median patient survival in months from symptom onset to death for this molecular subtype, where available." ;
    skos:inScheme alskg:alskg-schema .

alskg:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:range xsd:string ;
    skos:definition "Gene symbol or other short symbol, when available." ;
    skos:inScheme alskg:alskg-schema .

alskg:synonym_scope a owl:DatatypeProperty ;
    rdfs:label "synonym_scope" ;
    rdfs:range xsd:string ;
    skos:definition "Scope or type of synonym, such as exact, broad, narrow, related, symbol synonym, obsolete symbol, or trade name." ;
    skos:inScheme alskg:alskg-schema .

alskg:therapeutic_intervention_tested_in_clinical_trial a owl:ObjectProperty ;
    rdfs:label "therapeutic_intervention_tested_in_clinical_trial" ;
    rdfs:range alskg:ClinicalTrial ;
    skos:definition "Connects a therapeutic intervention to a clinical trial that tests it." ;
    skos:inScheme alskg:alskg-schema .

alskg:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "Human-readable title of the ontology (e.g. \"Human Phenotype Ontology\")" ;
    skos:inScheme alskg:alskg-schema .

alskg:unique_ingredient_identifier a owl:DatatypeProperty ;
    rdfs:label "unique_ingredient_identifier" ;
    skos:definition "FDA Unique Ingredient Identifier (UNII) — a non-proprietary, free, unique, unambiguous, non-semantic, alphanumeric identifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:variant_affects_gene a owl:ObjectProperty ;
    rdfs:label "variant_affects_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a sequence variant to the gene it affects." ;
    skos:inScheme alskg:alskg-schema .

alskg:variant_alters_protein a owl:ObjectProperty ;
    rdfs:label "variant_alters_protein" ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a sequence variant to a protein it alters." ;
    skos:inScheme alskg:alskg-schema .

alskg:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    skos:definition "Year of the study providing this expression evidence." ;
    skos:inScheme alskg:alskg-schema .

alskg:year_of_first_approval a owl:DatatypeProperty ;
    rdfs:label "year_of_first_approval" ;
    skos:definition "Calendar year of first regulatory approval (any jurisdiction)" ;
    skos:inScheme alskg:alskg-schema .

alskg:DiseaseStage a owl:Class ;
    rdfs:label "DiseaseStage" ;
    rdfs:subClassOf alskg:ClinicalEntity ;
    skos:definition "A temporal or clinical stage of ALS, such as early disease, established disease, late disease, pre-symptomatic carrier state, or time since symptom onset." ;
    skos:exactMatch alskg:DiseaseStage ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "DST" .

alskg:DrugRepurposingHypothesis a owl:Class ;
    rdfs:label "DrugRepurposingHypothesis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:prioritizes_drug ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_prioritizes_drug ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:targets_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicMechanism ;
            owl:onProperty alskg:modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceStatement ;
            owl:onProperty alskg:has_evidence_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:targets_gene ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_prioritizes_drug ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:drug_repurposing_hypothesis_prioritizes_drug ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:prioritizes_drug ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:drug_repurposing_hypothesis_targets_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicMechanism ;
            owl:onProperty alskg:drug_repurposing_hypothesis_modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_targets_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:targets_protein ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:prioritizes_drug ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_modulates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Protein ;
            owl:onProperty alskg:targets_protein ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:drug_repurposing_hypothesis_targets_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_evidence_basis ],
        alskg:EvidenceStatement ;
    skos:definition "A hypothesis that a drug or therapeutic intervention may be relevant to ALS or an ALS subtype based on target genes, disease mechanisms, expression directionality, pathways, biomarkers, model evidence, or clinical evidence." ;
    skos:exactMatch alskg:DrugRepurposingHypothesis ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "DRH" .

alskg:DrugTractabilityModalityEnum a owl:Class ;
    rdfs:label "DrugTractabilityModalityEnum" ;
    skos:definition "Drug discovery modality categories for tractability assessments on Gene nodes. Sourced from Open Targets tractability pipeline." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#ab>,
        <https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#oc>,
        <https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#pr>,
        <https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#sm> .

alskg:FunctionalAnnotationRelationship a owl:Class ;
    rdfs:label "FunctionalAnnotationRelationship" ;
    rdfs:subClassOf alskg:RelationshipAssertion ;
    skos:definition "Abstract family for GO annotation and pathway membership relationships. Connects genes to biological processes (BPO-GEN), cellular components (CCO-GEN), molecular functions (MFN-GEN), and pathways (PWY-GEN). One of the four canonical relationship families in OptimusKG v0.4.0." ;
    skos:exactMatch okg:FunctionalAnnotationRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:MolecularSubtypeClassificationBasisEnum a owl:Class ;
    rdfs:label "MolecularSubtypeClassificationBasisEnum" ;
    skos:definition "Computational or experimental basis used to define and assign molecular subtypes. Describes how the subtype was derived from raw data." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/MolecularSubtypeClassificationBasisEnum#bootstrap_clustering>,
        <https://w3id.org/alskg/schema/MolecularSubtypeClassificationBasisEnum#deep_multiomics_classifier>,
        <https://w3id.org/alskg/schema/MolecularSubtypeClassificationBasisEnum#unsupervised_transcriptomics> .

alskg:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:pmid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:pmid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:pmid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        alskg:ProvenanceEntity ;
    skos:definition "A publication or bibliographic reference that supports an OptimusKG assertion or evidence item." ;
    skos:exactMatch biolink:Publication ;
    skos:inScheme alskg:alskg-schema .

alskg:Sample a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:derived_from_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:derived_from_anatomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:derived_from_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellType ;
            owl:onProperty alskg:has_cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:occurs_in_disease_context ],
        alskg:ProvenanceEntity ;
    skos:definition "A biological sample or specimen used in ALS analysis, such as postmortem spinal cord, motor cortex, CSF, blood, iPSC-derived motor neurons, or sorted cell populations." ;
    skos:exactMatch OBI:0100051 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "SMP" .

alskg:Synonym a owl:Class ;
    rdfs:label "Synonym" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:synonym_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:synonym_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:synonym_scope ],
        alskg:ProvenanceEntity ;
    skos:definition "A lexical synonym, alias, obsolete label, or alternate name with optional source attribution." ;
    skos:exactMatch skos:altLabel ;
    skos:inScheme alskg:alskg-schema .

alskg:ancestors a owl:DatatypeProperty ;
    rdfs:label "ancestors" ;
    rdfs:range xsd:string ;
    skos:definition "All transitive ancestor identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:broad_synonyms a owl:DatatypeProperty ;
    rdfs:label "broad_synonyms" ;
    rdfs:range xsd:string ;
    skos:definition "Broader synonym labels." ;
    skos:inScheme alskg:alskg-schema .

alskg:children a owl:DatatypeProperty ;
    rdfs:label "children" ;
    rdfs:range xsd:string ;
    skos:definition "Direct child identifiers in a hierarchy." ;
    skos:inScheme alskg:alskg-schema .

alskg:concept_ids a owl:DatatypeProperty ;
    rdfs:label "concept_ids" ;
    rdfs:range xsd:string ;
    skos:definition "Linked concept identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:concept_names a owl:DatatypeProperty ;
    rdfs:label "concept_names" ;
    rdfs:range xsd:string ;
    skos:definition "Names corresponding to linked concept identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:descendants a owl:DatatypeProperty ;
    rdfs:label "descendants" ;
    rdfs:range xsd:string ;
    skos:definition "All transitive descendant identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:exact_synonyms a owl:DatatypeProperty ;
    rdfs:label "exact_synonyms" ;
    rdfs:range xsd:string ;
    skos:definition "Exact synonym labels." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_expression_result a owl:ObjectProperty ;
    rdfs:label "has_expression_result" ;
    rdfs:range alskg:DifferentialExpressionStatement ;
    skos:definition "Connects a disease or subtype to a differential expression result." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "has_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects ALS, an ALS subtype, or an assertion to a pathogenic mechanism." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_phenotype_observation a owl:ObjectProperty ;
    rdfs:label "has_phenotype_observation" ;
    rdfs:range alskg:PhenotypeObservation ;
    skos:definition "Connects a disease or subtype to a contextual phenotype observation." ;
    skos:inScheme alskg:alskg-schema .

alskg:narrow_synonyms a owl:DatatypeProperty ;
    rdfs:label "narrow_synonyms" ;
    rdfs:range xsd:string ;
    skos:definition "Narrower synonym labels." ;
    skos:inScheme alskg:alskg-schema .

alskg:obsolete_terms a owl:DatatypeProperty ;
    rdfs:label "obsolete_terms" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecated term labels." ;
    skos:inScheme alskg:alskg-schema .

alskg:obsolete_xrefs a owl:DatatypeProperty ;
    rdfs:label "obsolete_xrefs" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecated cross-references." ;
    skos:inScheme alskg:alskg-schema .

alskg:parents a owl:DatatypeProperty ;
    rdfs:label "parents" ;
    rdfs:range xsd:string ;
    skos:definition "Direct parent identifiers in a hierarchy." ;
    skos:inScheme alskg:alskg-schema .

alskg:related_synonyms a owl:DatatypeProperty ;
    rdfs:label "related_synonyms" ;
    rdfs:range xsd:string ;
    skos:definition "Related synonym labels." ;
    skos:inScheme alskg:alskg-schema .

alskg:snomed_concept_ids a owl:DatatypeProperty ;
    rdfs:label "snomed_concept_ids" ;
    rdfs:range xsd:string ;
    skos:definition "SNOMED CT concept identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:snomed_full_names a owl:DatatypeProperty ;
    rdfs:label "snomed_full_names" ;
    rdfs:range xsd:string ;
    skos:definition "SNOMED CT preferred full concept names." ;
    skos:inScheme alskg:alskg-schema .

alskg:source_ids a owl:DatatypeProperty ;
    rdfs:label "source_ids" ;
    rdfs:range xsd:string ;
    skos:definition "Source-specific identifiers for cross-referencing." ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSExpressionRelationship a owl:Class ;
    rdfs:label "ALSExpressionRelationship" ;
    rdfs:subClassOf alskg:ALSRelationship ;
    skos:definition "Relationships connecting differential expression results to genes, subtype, anatomy, cell type, sample, assay, cohort, dataset, and evidence." ;
    skos:exactMatch alskg:ALSExpressionRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:Cohort a owl:Class ;
    rdfs:label "Cohort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        alskg:ProvenanceEntity ;
    skos:definition "A participant group, case/control group, genotype group, subtype group, or study cohort used in ALS research." ;
    skos:exactMatch OBI:0000202 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "COH" .

alskg:DrugPhenotypeTherapeuticRelationship a owl:Class ;
    rdfs:label "DrugPhenotypeTherapeuticRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:reference_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:drug_disease_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:drug_disease_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:structure_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:reference_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:highest_clinical_trial_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:drug_disease_id ],
        alskg:PharmacologicalRelationship ;
    skos:definition """Parent class for drug-to-phenotype therapeutic and adverse-event relationships.

Property detail: Drug effects on clinical phenotypic outcomes, including adverse reactions, indications, contraindications, and off-label uses. Relations: ADVERSE_DRUG_REACTION, ASSOCIATED_WITH, CONTRAINDICATION, INDICATION, OFF_LABEL_USE. Undirected: True. Count: 13,758. Sources: DrugCentral, OnSIDES, Open Targets. OnSIDES data: adverse drug events extracted from FDA labels using PubMedBERT.""" ;
    skos:exactMatch okg:DrugPhenotypeTherapeuticRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ExposureEntityRelationship a owl:Class ;
    rdfs:label "ExposureEntityRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Exposure ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:AssociationRelationship ;
    skos:definition "Abstract family for exposure-to-entity association relationships. Now a subclass of AssociationRelationship rather than a direct child of RelationshipAssertion (v0.4.0 consolidation). Subject is always an Exposure node." ;
    skos:exactMatch okg:ExposureEntityRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:SexEnum a owl:Class ;
    rdfs:label "SexEnum" ;
    skos:definition "Biological sex or sex category used in a study or observation when reported." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/SexEnum#female>,
        <https://w3id.org/alskg/schema/SexEnum#male>,
        <https://w3id.org/alskg/schema/SexEnum#mixed>,
        <https://w3id.org/alskg/schema/SexEnum#unknown> .

alskg:evidence_type a owl:DatatypeProperty ;
    rdfs:label "evidence_type" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence category, evidence code, or source-specific evidence type supporting an assertion.",
        "Evidence type codes (e.g. \"IEA\" = Inferred from Electronic Annotation, \"PCS\" = Published Clinical Study, \"TAS\" = Traceable Author Statement)" ;
    skos:inScheme alskg:alskg-schema .

xsd:anyURI a rdfs:Datatype .

alskg:ALSEvidenceRelationship a owl:Class ;
    rdfs:label "ALSEvidenceRelationship" ;
    rdfs:subClassOf alskg:ALSRelationship ;
    skos:definition "Relationships connecting ALS-KG statements, results, subtypes, and hypotheses to studies, datasets, cohorts, samples, assays, publications, and evidence." ;
    skos:exactMatch alskg:ALSEvidenceRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSRelationship a owl:Class ;
    rdfs:label "ALSRelationship" ;
    rdfs:subClassOf alskg:RelationshipAssertion ;
    skos:definition "Abstract parent for ALS-KG extension relationships that can be materialized in Neo4j while preserving OptimusKG compatibility." ;
    skos:exactMatch alskg:ALSRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSTherapeuticRelationship a owl:Class ;
    rdfs:label "ALSTherapeuticRelationship" ;
    rdfs:subClassOf alskg:ALSRelationship ;
    skos:definition "Relationships supporting ALS therapeutic intervention, target, clinical trial, and drug repurposing hypotheses." ;
    skos:exactMatch alskg:ALSTherapeuticRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:HomologyTypeEnum a owl:Class ;
    rdfs:label "HomologyTypeEnum" ;
    skos:definition "Types of homology relationships in gene homologue annotations on Gene nodes." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/HomologyTypeEnum#gene_split>,
        <https://w3id.org/alskg/schema/HomologyTypeEnum#ortholog_many2many>,
        <https://w3id.org/alskg/schema/HomologyTypeEnum#ortholog_one2many>,
        <https://w3id.org/alskg/schema/HomologyTypeEnum#ortholog_one2one>,
        <https://w3id.org/alskg/schema/HomologyTypeEnum#other_paralog>,
        <https://w3id.org/alskg/schema/HomologyTypeEnum#within_species_paralog> .

alskg:OntologyClass a owl:Class ;
    rdfs:label "OntologyClass" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Synonym ;
            owl:onProperty alskg:has_synonym ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DatabaseAccession ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_synonym ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:OntologyMetadata ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:ontology ],
        alskg:NamedEntity ;
    skos:definition "Abstract mid-tier for entity types grounded in an OBO/OWL ontology or curated pathway database. All subclasses carry ontology header metadata (title, version, license, definition) and cross-references. Covers: Anatomy (Uberon), BiologicalProcess (GO), CellularComponent (GO), MolecularFunction (GO), Pathway (Reactome)." ;
    skos:exactMatch owl:Class ;
    skos:inScheme alskg:alskg-schema .

alskg:PhysicalEntity a owl:Class ;
    rdfs:label "PhysicalEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:DatabaseAccession ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_synonym ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Synonym ;
            owl:onProperty alskg:has_synonym ],
        alskg:NamedEntity ;
    skos:definition "Abstract mid-tier for physically real, structurally defined entities whose identity is established by a structure or sequence database (not by an ontology concept hierarchy). Merges the former MolecularEntity (Gene, Protein) and ChemicalEntity (Drug, Exposure) branches into one family. Biolink alignment: biolink:ChemicalEntityOrGeneOrGeneProduct covers this combined family. Covers: Gene (ENSG), Protein (UniProt), Drug (ChEMBL/DrugBank/RxNorm), Exposure (MeSH/CTD)." ;
    skos:exactMatch biolink:ChemicalEntityOrGeneOrGeneProduct ;
    skos:inScheme alskg:alskg-schema .

alskg:SubtypeCriterion a owl:Class ;
    rdfs:label "SubtypeCriterion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        alskg:AnalyticalEntity ;
    skos:definition "A criterion used to assign or define an ALS subtype, such as a gene variant, symptom pattern, anatomical onset region, transcriptomic signature, pathology feature, or progression threshold." ;
    skos:exactMatch alskg:SubtypeCriterion ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "SCR" .

alskg:SubtypeScheme a owl:Class ;
    rdfs:label "SubtypeScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        alskg:AnalyticalEntity ;
    skos:definition "A scheme or taxonomy used to classify ALS subtypes, such as clinical-onset subtype, ALS-OPM motor phenotype, genotype subtype, molecular cluster, pathology subtype, or progression subtype." ;
    skos:exactMatch alskg:SubtypeScheme ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "SSC" .

alskg:affects_anatomy a owl:ObjectProperty ;
    rdfs:label "affects_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a disease, subtype, mechanism, or result to an affected anatomical structure." ;
    skos:inScheme alskg:alskg-schema .

alskg:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:range xsd:string ;
    skos:definition "Primary ontology or source code." ;
    skos:inScheme alskg:alskg-schema .

alskg:confidence_score a owl:DatatypeProperty ;
    rdfs:label "confidence_score" ;
    rdfs:range xsd:float ;
    skos:definition "Numeric confidence score for an assertion or result." ;
    skos:inScheme alskg:alskg-schema .

alskg:cui_semantic_type a owl:DatatypeProperty ;
    rdfs:label "cui_semantic_type" ;
    rdfs:range xsd:string ;
    skos:definition "Semantic type attached to a concept identifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:drug_disease_id a owl:DatatypeProperty ;
    rdfs:label "drug_disease_id" ;
    rdfs:range xsd:string ;
    skos:definition "Source-internal drug-disease or drug-phenotype association identifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_cross_reference a owl:ObjectProperty ;
    rdfs:label "has_cross_reference" ;
    rdfs:range alskg:DatabaseAccession ;
    skos:definition "Connects an entity to a structured CrossReference or DatabaseAccession node." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_publication a owl:ObjectProperty ;
    rdfs:label "has_publication" ;
    rdfs:range alskg:Publication ;
    skos:definition "Connects an evidence record or statement to a supporting publication." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_synonym a owl:ObjectProperty ;
    rdfs:label "has_synonym" ;
    rdfs:range alskg:Synonym ;
    skos:definition "Connects an entity to a structured Synonym node." ;
    skos:inScheme alskg:alskg-schema .

alskg:involves_cell_type a owl:ObjectProperty ;
    rdfs:label "involves_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a disease, subtype, mechanism, or observation to a relevant cell type." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_leaf a owl:DatatypeProperty ;
    rdfs:label "is_leaf" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether a hierarchy node has no children." ;
    skos:inScheme alskg:alskg-schema .

alskg:measured_in_sample a owl:ObjectProperty ;
    rdfs:label "measured_in_sample" ;
    rdfs:range alskg:Sample ;
    skos:definition "Connects a result to the biological sample measured." ;
    skos:inScheme alskg:alskg-schema .

alskg:modulates_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "modulates_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a drug/intervention/hypothesis to the pathogenic mechanism it modulates." ;
    skos:inScheme alskg:alskg-schema .

alskg:original_optimus_label a owl:ObjectProperty ;
    rdfs:label "original_optimus_label" ;
    rdfs:range alskg:NodeLabelEnum ;
    skos:definition "Original three-letter OptimusKG node label as stored in Neo4j, such as GEN, DIS, or DRG." ;
    skos:inScheme alskg:alskg-schema .

alskg:reference_ids a owl:DatatypeProperty ;
    rdfs:label "reference_ids" ;
    rdfs:range xsd:string ;
    skos:definition "Supporting external reference identifiers." ;
    skos:inScheme alskg:alskg-schema .

alskg:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:range xsd:string ;
    skos:definition "Regulatory development status string (e.g. \"Approved\", \"Investigational\", \"Withdrawn\", \"Experimental\").",
        "Status of a record, accession, drug, or assertion, such as reviewed, unreviewed, approved, withdrawn, active, or obsolete." ;
    skos:inScheme alskg:alskg-schema .

alskg:structure_id a owl:DatatypeProperty ;
    rdfs:label "structure_id" ;
    rdfs:range xsd:string ;
    skos:definition "Source-internal structure identifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:targets_gene a owl:ObjectProperty ;
    rdfs:label "targets_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects a drug, intervention, or hypothesis to a target gene." ;
    skos:inScheme alskg:alskg-schema .

alskg:targets_protein a owl:ObjectProperty ;
    rdfs:label "targets_protein" ;
    rdfs:range alskg:Protein ;
    skos:definition "Connects a drug, intervention, or hypothesis to a target protein." ;
    skos:inScheme alskg:alskg-schema .

alskg:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "Source-specific type or classification label." ;
    skos:inScheme alskg:alskg-schema .

alskg:umls_cui a owl:DatatypeProperty ;
    rdfs:label "umls_cui" ;
    rdfs:range xsd:string ;
    skos:definition "Primary UMLS Concept Unique Identifier." ;
    skos:inScheme alskg:alskg-schema .

alskg:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version of an accession, database record, dataset, or schema when known.",
        "Version string or release date of the ontology (e.g. \"v2025-05-06\" for HPO, \"v656\" for DOID, \"current\" for dynamic releases)" ;
    skos:inScheme alskg:alskg-schema .

alskg:AnalyticalEntity a owl:Class ;
    rdfs:label "AnalyticalEntity" ;
    rdfs:subClassOf alskg:NamedEntity ;
    skos:definition "Abstract mid-tier for entities whose identity is established by a computational analysis rather than an ontology or physical database. These are reified analytical findings promoted to named nodes because they accumulate enough properties and relationships to warrant first-class graph identity. Covers: MolecularSubtype (transcriptomic patient strata, MST label), GeneExpressionContext (reified differential expression findings, ECX label)." ;
    skos:exactMatch biolink:StudyResult ;
    skos:inScheme alskg:alskg-schema .

alskg:ClinicalEntity a owl:Class ;
    rdfs:label "ClinicalEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Synonym ;
            owl:onProperty alskg:has_synonym ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DatabaseAccession ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_cross_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_synonym ],
        alskg:NamedEntity ;
    skos:definition "Abstract mid-tier for clinical observation categories grounded in disease and phenotype ontologies. Both subclasses carry UMLS CUIs, SNOMED CT mappings, and full ontological hierarchy (parents, ancestors, is_leaf). Covers: Disease (MONDO, DOID, EFO, Orphanet, NCIT), Phenotype (HPO, MedDRA)." ;
    skos:exactMatch biolink:DiseaseOrPhenotypicFeature ;
    skos:inScheme alskg:alskg-schema .

alskg:ClinicalTrial a owl:Class ;
    rdfs:label "ClinicalTrial" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:TherapeuticIntervention ;
            owl:onProperty alskg:tests_intervention ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_outcome_measure ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:NamedEntity ;
            owl:onProperty alskg:has_outcome_measure ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:clinical_trial_enrolls_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:tests_intervention ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:clinical_trial_enrolls_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:clinical_trial_enrolls_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:enrolls_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:enrolls_subtype ],
        alskg:Study ;
    skos:definition "A clinical trial or interventional study relevant to ALS, ALS subtypes, therapies, biomarkers, or outcomes." ;
    skos:exactMatch biolink:ClinicalTrial ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "TRI" .

alskg:EvidenceStrengthEnum a owl:Class ;
    rdfs:label "EvidenceStrengthEnum" ;
    skos:definition "Qualitative evidence strength for a scientific assertion." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/EvidenceStrengthEnum#conflicting>,
        <https://w3id.org/alskg/schema/EvidenceStrengthEnum#definitive>,
        <https://w3id.org/alskg/schema/EvidenceStrengthEnum#moderate>,
        <https://w3id.org/alskg/schema/EvidenceStrengthEnum#strong>,
        <https://w3id.org/alskg/schema/EvidenceStrengthEnum#unknown>,
        <https://w3id.org/alskg/schema/EvidenceStrengthEnum#weak> .

alskg:Pathway a owl:Class ;
    rdfs:label "Pathway" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:species ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:species ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:species ],
        alskg:OntologyClass ;
    skos:definition """A biological pathway represented in OptimusKG. Current Neo4j label: `PWY`.

Property detail from OptimusKG source schema: A biological pathway node. Represents 2,805 curated pathways (1.5% of nodes) from Reactome, covering molecular reactions, signaling cascades, metabolic processes, and disease pathways in human cells. Sources: Open Targets, Reactome. Node file: nodes/pathway.parquet""" ;
    skos:exactMatch biolink:Pathway ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "PWY" ;
    alskg:optimus_abbreviation "PWY" ;
    alskg:property_schema_source "PathwayNode" .

alskg:RepurposingStatusEnum a owl:Class ;
    rdfs:label "RepurposingStatusEnum" ;
    skos:definition "Status of a drug repurposing hypothesis." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/RepurposingStatusEnum#clinically_tested>,
        <https://w3id.org/alskg/schema/RepurposingStatusEnum#deprioritized>,
        <https://w3id.org/alskg/schema/RepurposingStatusEnum#experimentally_supported>,
        <https://w3id.org/alskg/schema/RepurposingStatusEnum#prioritized>,
        <https://w3id.org/alskg/schema/RepurposingStatusEnum#proposed>,
        <https://w3id.org/alskg/schema/RepurposingStatusEnum#rejected> .

alskg:Assay a owl:Class ;
    rdfs:label "Assay" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        alskg:ProvenanceEntity ;
    skos:definition "An assay or measurement method used to generate ALS evidence, such as bulk RNA-seq, single-nucleus RNA-seq, spatial transcriptomics, proteomics, WGS, immunostaining, or clinical assessment." ;
    skos:exactMatch OBI:0000070 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "ASY" .

alskg:AssociationRelationship a owl:Class ;
    rdfs:label "AssociationRelationship" ;
    rdfs:subClassOf alskg:RelationshipAssertion ;
    skos:definition "Abstract family for evidence-bearing association edges between biomedical entities. Covers gene-disease, disease-phenotype, phenotype-gene, drug-drug, drug-gene, exposure-entity, and gene-gene interaction relationships. Renamed from EntityAssociationRelationship (v0.3.0) for clarity." ;
    skos:exactMatch okg:AssociationRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:CellularComponent a owl:Class ;
    rdfs:label "CellularComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:xrefs ],
        alskg:OntologyClass ;
    skos:definition """A Gene Ontology cellular component term represented in OptimusKG. Current Neo4j label: `CCO`.

Property detail from OptimusKG source schema: A Gene Ontology (GO) cellular component node. Represents 4,052 subcellular structures and compartments (2.1% of nodes) where gene products are active or located (e.g. "nucleus", "mitochondria", "plasma membrane", "ribosome"). Source: Gene Ontology (GO). Node file: nodes/cellular_component.parquet""" ;
    skos:exactMatch biolink:CellularComponent ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "CCO" ;
    alskg:optimus_abbreviation "CCO" ;
    alskg:property_schema_source "CellularComponentNode" .

alskg:DatabaseAccession a owl:Class ;
    rdfs:label "DatabaseAccession" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:accession ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:accession ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:accession ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:version ],
        alskg:ProvenanceEntity ;
    skos:definition "A database-specific identifier or accession for a biological entity. This class allows accessions to be modeled as nodes rather than JSON strings." ;
    skos:exactMatch alskg:DatabaseAccession ;
    skos:inScheme alskg:alskg-schema .

alskg:GeneExpressionContext a owl:Class ;
    rdfs:label "GeneExpressionContext" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:biological_context_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:molecular_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty alskg:year ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:cell_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularSubtype ;
            owl:onProperty alskg:molecular_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:biological_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:validated_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:validated_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:anatomy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:BiologicalContextTypeEnum ;
            owl:onProperty alskg:biological_context_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:gene ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:biological_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:anatomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:cell_model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:biological_context_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:anatomy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:cell_model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:biological_note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:molecular_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:year ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:year ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ExpressionDirectionEnum ;
            owl:onProperty alskg:direction ],
        alskg:DifferentialExpressionStatement ;
    skos:definition "Neo4j-compatible concrete expression-context node for ALS-KG. Prefer the parent class DifferentialExpressionStatement for ontology semantics; use GeneExpressionContext when materializing expression findings as Neo4j nodes such as ECX." ;
    skos:exactMatch alskg:GeneExpressionContext ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "ECX" ;
    alskg:source_note "Primary data from NIHMS2069122-supplement-5.xlsx TableS3A (NYGC ALS Consortium postmortem cortex and cord) and TableS3E (Ziff et al. 2023 iPSC motor neuron models). Replaces the binary DYSREGULATED_IN edge (GEN->MST)." .

alskg:contributes_to_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "contributes_to_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a gene, variant, protein, molecular event, or statement to a pathogenic mechanism it contributes to." ;
    skos:inScheme alskg:alskg-schema .

alskg:occurs_in_anatomy a owl:ObjectProperty ;
    rdfs:label "occurs_in_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a mechanism, event, statement, or result to the anatomy where it occurs." ;
    skos:inScheme alskg:alskg-schema .

alskg:occurs_in_cell_type a owl:ObjectProperty ;
    rdfs:label "occurs_in_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a mechanism, event, statement, or result to the cell type where it occurs." ;
    skos:inScheme alskg:alskg-schema .

alskg:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_publication ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Publication ;
            owl:onProperty alskg:has_publication ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        alskg:ProvenanceEntity ;
    skos:definition "A dataset used as evidence or source for ALS-KG statements, such as Target ALS, Answer ALS, NYGC ALS, Project MinE, ALL ALS, or GEO studies." ;
    skos:exactMatch schema1:Dataset ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "DAT" .

alskg:EvidenceStatement a owl:Class ;
    rdfs:label "EvidenceStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Dataset ;
            owl:onProperty alskg:derives_from_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Dataset ;
            owl:onProperty alskg:evidence_statement_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:evidence_statement_supported_by_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:evidence_statement_supported_by_evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Cohort ;
            owl:onProperty alskg:occurs_in_cohort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_cohort ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:evidence_statement_supported_by_evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:derives_from_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_cohort ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:evidence_statement_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:evidence_statement_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:derives_from_dataset ],
        alskg:AnalyticalEntity ;
    skos:definition "A reified, evidence-backed assertion in ALS-KG. Use statement/result nodes when the claim depends on subtype, tissue, cell type, cohort, assay, statistical support, or publication evidence." ;
    skos:exactMatch rdf:Statement ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "EST" .

alskg:PathogenicityEnum a owl:Class ;
    rdfs:label "PathogenicityEnum" ;
    skos:definition "Clinical or research pathogenicity interpretation of a genetic variant." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/PathogenicityEnum#benign>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#likely_benign>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#likely_pathogenic>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#pathogenic>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#risk_factor>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#uncertain_significance>,
        <https://w3id.org/alskg/schema/PathogenicityEnum#unknown> .

alskg:PhenotypeObservation a owl:Class ;
    rdfs:label "PhenotypeObservation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:DiseaseStage ;
            owl:onProperty alskg:has_disease_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_disease_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:phenotype_observation_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:phenotype_observation_has_observed_phenotype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:phenotype_observation_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:has_observed_phenotype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:phenotype_observation_has_observed_phenotype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ProgressionPattern ;
            owl:onProperty alskg:has_progression_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_disease_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_progression_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:phenotype_observation_has_observed_phenotype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:phenotype_observation_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_progression_pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_observed_phenotype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_observed_phenotype ],
        alskg:EvidenceStatement ;
    skos:definition "A contextual observation that a phenotype, symptom, sign, or clinical feature is present, absent, frequent, rare, early, late, or otherwise characterized in ALS or an ALS subtype." ;
    skos:exactMatch alskg:PhenotypeObservation ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "POB" .

alskg:RelationshipAssertion a owl:Class ;
    rdfs:label "RelationshipAssertion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:has_evidence_record ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_evidence_record ] ;
    skos:definition "Abstract root class for all typed, asserted relationships between named entities in OptimusKG. All family-level abstract classes and concrete relationship classes inherit subject, object, undirected, sources, and evidence slots from here. Four canonical direct children: HierarchyRelationship, AssociationRelationship, PharmacologicalRelationship, FunctionalAnnotationRelationship. Additional families: ExposureEntityRelationship (under AssociationRelationship), ExpressionRelationship (under AssociationRelationship), MolecularSubtypeRelationship (direct child, covers AnalyticalEntity edges)." ;
    skos:exactMatch rdf:Statement ;
    skos:inScheme alskg:alskg-schema .

alskg:highest_clinical_trial_phase a owl:DatatypeProperty ;
    rdfs:label "highest_clinical_trial_phase" ;
    rdfs:range xsd:float ;
    skos:definition "Highest clinical-trial phase achieved for an association." ;
    skos:inScheme alskg:alskg-schema .

alskg:measured_by_assay a owl:ObjectProperty ;
    rdfs:label "measured_by_assay" ;
    rdfs:range alskg:Assay ;
    skos:definition "Connects a result, biomarker, or observation to the assay that measured it." ;
    skos:inScheme alskg:alskg-schema .

alskg:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A resolvable URL for a source, publication, evidence record, or web resource." ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSSubtypeRelationship a owl:Class ;
    rdfs:label "ALSSubtypeRelationship" ;
    rdfs:subClassOf alskg:ALSRelationship ;
    skos:definition "Relationships defining, classifying, or contextualizing ALS subtypes." ;
    skos:exactMatch alskg:ALSSubtypeRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:BiologicalContextTypeEnum a owl:Class ;
    rdfs:label "BiologicalContextTypeEnum" ;
    skos:definition "Type of biological context (tissue or cell model) in which molecular subtype gene expression was measured. Used on DYSREGULATED_IN edges." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#C9orf72_motor_neuron>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#FUS_motor_neuron>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#TDP43_motor_neuron>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#iPSC_motor_neuron>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#postmortem_cord>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#postmortem_cortex>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#spinal_cord_cervical>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#spinal_cord_lumbar>,
        <https://w3id.org/alskg/schema/BiologicalContextTypeEnum#spinal_cord_thoracic> .

alskg:DrugActionDirectionEnum a owl:Class ;
    rdfs:label "DrugActionDirectionEnum" ;
    skos:definition "Direction or mechanism of a drug action on a target or biological process." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/DrugActionDirectionEnum#activates>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#agonizes>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#antagonizes>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#binds>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#degrades>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#inhibits>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#modulates>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#stabilizes>,
        <https://w3id.org/alskg/schema/DrugActionDirectionEnum#unknown> .

alskg:HierarchyRelationship a owl:Class ;
    rdfs:label "HierarchyRelationship" ;
    rdfs:subClassOf alskg:RelationshipAssertion ;
    skos:definition "A parent, subclass, or ontology hierarchy relationship in the current OptimusKG Neo4j graph. This groups PARENT and IS_A edges while preserving the exact Neo4j relationship type in each concrete subclass." ;
    skos:exactMatch okg:HierarchyRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:MolecularFunction a owl:Class ;
    rdfs:label "MolecularFunction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:xrefs ],
        alskg:OntologyClass ;
    skos:definition """A Gene Ontology molecular function term represented in OptimusKG. Current Neo4j label: `MFN`.

Property detail from OptimusKG source schema: A Gene Ontology (GO) molecular function node. Represents 10,161 biochemical and enzymatic activities (5.3% of nodes) that gene products perform at the molecular level (e.g. "protein kinase activity", "DNA binding", "ATP hydrolysis activity"). Source: Gene Ontology (GO). Node file: nodes/molecular_function.parquet""" ;
    skos:exactMatch biolink:MolecularActivity ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "MFN" ;
    alskg:optimus_abbreviation "MFN" ;
    alskg:property_schema_source "MolecularFunctionNode" .

alskg:SubtypeAxisEnum a owl:Class ;
    rdfs:label "SubtypeAxisEnum" ;
    skos:definition "Axes along which ALS subtypes may be defined." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/SubtypeAxisEnum#anatomical>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#clinical_onset>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#cognitive_behavioral>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#genetic>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#model_system>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#molecular>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#motor_neuron_involvement>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#pathology>,
        <https://w3id.org/alskg/schema/SubtypeAxisEnum#progression> .

alskg:VariantConsequenceEnum a owl:Class ;
    rdfs:label "VariantConsequenceEnum" ;
    skos:definition "Broad variant consequence categories relevant to ALS." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/VariantConsequenceEnum#copy_number_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#frameshift_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#missense_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#noncoding_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#nonsense_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#repeat_expansion>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#splice_region_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#structural_variant>,
        <https://w3id.org/alskg/schema/VariantConsequenceEnum#unknown> .

alskg:DifferentialExpressionStatement a owl:Class ;
    rdfs:label "DifferentialExpressionStatement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Sample ;
            owl:onProperty alskg:measured_in_sample ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Dataset ;
            owl:onProperty alskg:differential_expression_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:has_p_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_false_discovery_rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:differential_expression_measures_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:compares_against ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_measured_by_assay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_measured_by_assay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_log_fold_change ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:compares_against ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:measured_in_sample ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
