    skos:definition "A biological mechanism that contributes to ALS initiation, progression, cellular dysfunction, or phenotype, such as TDP-43 proteinopathy, SOD1 toxic gain of function, C9orf72 repeat expansion toxicity, impaired RNA metabolism, mitochondrial dysfunction, oxidative stress, neuroinflammation, excitotoxicity, or impaired proteostasis." ;
    skos:exactMatch alskg:PathogenicMechanism ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "PGM" .

alskg:Anatomy a owl:Class ;
