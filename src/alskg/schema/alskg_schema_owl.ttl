@prefix MONDO: <http://purl.obolibrary.org/obo/MONDO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix SO: <http://purl.obolibrary.org/obo/SO_> .
@prefix alskg: <https://w3id.org/alskg/schema/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix okg: <https://w3id.org/optimuskg/schema/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

alskg:AmyotrophicLateralSclerosis a owl:Class ;
    rdfs:label "AmyotrophicLateralSclerosis" ;
    rdfs:subClassOf alskg:Disease ;
    skos:definition "Amyotrophic lateral sclerosis as the focal disease class for ALS-KG. Use this class for the ALS disease node when extending OptimusKG; it may be represented by the same MONDO/DOID identifier used by the OptimusKG Disease node." ;
    skos:exactMatch MONDO:0004976 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "ALS" .

alskg:AnatomyHasGeneExpressionAbsentRelationship a owl:Class ;
    rdfs:label "AnatomyHasGeneExpressionAbsentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:AnatomyGeneExpressionRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:ANA)-[:EXPRESSION_ABSENT]->(:GEN)`, represented with full class names as Anatomy -> Gene. Gene expression is reported absent in an anatomical context." ;
    skos:exactMatch okg:AnatomyExpressionAbsentGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "anatomy_expression_absent_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "EXPRESSION_ABSENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:AnatomyHasGeneExpressionPresentRelationship a owl:Class ;
    rdfs:label "AnatomyHasGeneExpressionPresentRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:AnatomyGeneExpressionRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:ANA)-[:EXPRESSION_PRESENT]->(:GEN)`, represented with full class names as Anatomy -> Gene. Gene expression is reported present in an anatomical context." ;
    skos:exactMatch okg:AnatomyExpressionPresentGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "anatomy_expression_present_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "EXPRESSION_PRESENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:AnatomyHasParentAnatomyRelationship a owl:Class ;
    rdfs:label "AnatomyHasParentAnatomyRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:ANA)-[:PARENT]->(:ANA)`, represented with full class names as Anatomy -> Anatomy. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:exactMatch okg:AnatomyParentAnatomyRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "anatomy_parent_anatomy" ;
    alskg:neo4j_end_label "ANA" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:BiologicalProcessHasParticipatingGeneRelationship a owl:Class ;
    rdfs:label "BiologicalProcessHasParticipatingGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:BiologicalProcess ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:FunctionalAnnotationRelationship ;
    skos:definition "A biological-process-to-gene relationship corresponding to Neo4j `(:BiologicalProcess)-[:INTERACTS_WITH]->(:Gene)`. In the semantic view, interpret as a gene annotated to or participating in a biological process, not necessarily a physical interaction." ;
    skos:exactMatch okg:BiologicalProcessInteractsWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "biologicalprocess_interacts_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "BPO" .

alskg:BiologicalProcessIsSubclassOfRelationship a owl:Class ;
    rdfs:label "BiologicalProcessIsSubclassOfRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:BiologicalProcess ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:BiologicalProcess ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:BPO)-[:IS_A]->(:BPO)`, represented with full class names as BiologicalProcess -> BiologicalProcess. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:exactMatch okg:BiologicalProcessIsABiologicalProcessRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "biologicalprocess_is_a_biologicalprocess" ;
    alskg:neo4j_end_label "BPO" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "BPO" .

alskg:CellularComponentHasLocatedGeneRelationship a owl:Class ;
    rdfs:label "CellularComponentHasLocatedGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellularComponent ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        alskg:FunctionalAnnotationRelationship ;
    skos:definition "A cellular-component-to-gene relationship corresponding to Neo4j `(:CellularComponent)-[:INTERACTS_WITH]->(:Gene)`. In the semantic view, interpret as gene/gene-product cellular component localization or annotation." ;
    skos:exactMatch okg:CellularComponentInteractsWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "cellularcomponent_interacts_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "CCO" .

alskg:CellularComponentIsSubclassOfRelationship a owl:Class ;
    rdfs:label "CellularComponentIsSubclassOfRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellularComponent ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellularComponent ;
            owl:onProperty alskg:object ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:CCO)-[:IS_A]->(:CCO)`, represented with full class names as CellularComponent -> CellularComponent. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:exactMatch okg:CellularComponentIsACellularComponentRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "cellularcomponent_is_a_cellularcomponent" ;
    alskg:neo4j_end_label "CCO" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "CCO" .

alskg:CrossReference a owl:Class ;
    rdfs:label "CrossReference" ;
    rdfs:subClassOf alskg:DatabaseAccession ;
    skos:definition "A cross-reference from an OptimusKG entity to an external database or ontology identifier." ;
    skos:exactMatch biolink:Attribute ;
    skos:inScheme alskg:alskg-schema .

alskg:DiseaseAssociatedWithGeneRelationship a owl:Class ;
    rdfs:label "DiseaseAssociatedWithGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        alskg:AssociationRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:DIS)-[:ASSOCIATED_WITH]->(:GEN)`, represented with full class names as Disease -> Gene. Association relationship; generally evidence-bearing but not necessarily causal." ;
    skos:exactMatch okg:DiseaseAssociatedWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "disease_associated_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "ASSOCIATED_WITH" ;
    alskg:neo4j_start_label "DIS" .

alskg:DiseaseHasMolecularSubtypeConcreteRelationship a owl:Class ;
    rdfs:label "DiseaseHasMolecularSubtypeConcreteRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularSubtype ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:MolecularSubtypeRelationship ;
    skos:definition "Reified schema class for the Neo4j pattern `(:DIS)-[:HAS_MOLECULAR_SUBTYPE]->(:MST)`, represented with full class names as Disease -> MolecularSubtype. Indicates that a disease node is associated with a transcriptome-derived molecular subtype. This is a cross-cutting classification relationship, not an ontological subclass assertion." ;
    skos:exactMatch okg:DiseaseHasMolecularSubtypeRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "disease_has_molecular_subtype" ;
    alskg:neo4j_end_label "MST" ;
    alskg:neo4j_relationship_type "HAS_MOLECULAR_SUBTYPE" ;
    alskg:neo4j_start_label "DIS" ;
    alskg:semantic_view_note "Cross-cutting classification relationship; does not imply ontological subclassing. A Disease can HAS_MOLECULAR_SUBTYPE multiple MolecularSubtype nodes simultaneously." .

alskg:DiseaseHasParentDiseaseRelationship a owl:Class ;
    rdfs:label "DiseaseHasParentDiseaseRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:DIS)-[:PARENT]->(:DIS)`, represented with full class names as Disease -> Disease. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:exactMatch okg:DiseaseParentDiseaseRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "disease_parent_disease" ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "DIS" .

alskg:DiseaseHasPhenotypeRelationship a owl:Class ;
    rdfs:label "DiseaseHasPhenotypeRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:DiseasePhenotypeRelationship ;
    skos:definition "A disease-to-phenotype relationship corresponding to Neo4j `(:Disease)-[:PHENOTYPE_PRESENT]->(:Phenotype)`. It means the disease has/presents the phenotype. The inverse natural-language reading is \"the phenotype is present in the disease\", but the current graph direction is Disease -> Phenotype." ;
    skos:exactMatch okg:DiseasePhenotypePresentPhenotypeRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "disease_phenotype_present_phenotype" ;
    alskg:neo4j_end_label "PHE" ;
    alskg:neo4j_relationship_type "PHENOTYPE_PRESENT" ;
    alskg:neo4j_start_label "DIS" .

alskg:DrugActivatesGeneProductRelationship a owl:Class ;
    rdfs:label "DrugActivatesGeneProductRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        alskg:DrugGeneModulationRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:DRG)-[:ACTIVATOR]->(:GEN)`, represented with full class names as Drug -> Gene. Drug activates the gene product or target associated with the gene." ;
    skos:exactMatch okg:DrugActivatorGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "drug_activator_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "ACTIVATOR" ;
    alskg:neo4j_start_label "DRG" .

alskg:DrugAgonistOfGeneProductRelationship a owl:Class ;
    rdfs:label "DrugAgonistOfGeneProductRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:DrugGeneModulationRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:DRG)-[:AGONIST]->(:GEN)`, represented with full class names as Drug -> Gene. Drug acts as an agonist of the gene product or target associated with the gene." ;
    skos:exactMatch okg:DrugAgonistGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
