    skos:definition "Molecular subtype derived by unsupervised clustering of postmortem transcriptomes (e.g. k-means, hierarchical clustering, NMF)." .

alskg:MolecularSubtypeRelationship a owl:Class ;
    rdfs:label "MolecularSubtypeRelationship" ;
    rdfs:subClassOf alskg:RelationshipAssertion ;
    skos:definition "Abstract family for all relationships involving a MolecularSubtype (AnalyticalEntity) node. Groups disease-to-subtype (HAS_MOLECULAR_SUBTYPE), gene-to-subtype (DYSREGULATED_IN), and subtype-to-anatomy (MEASURED_IN) relationships. Kept as a distinct family because MolecularSubtype is an AnalyticalEntity, not a standard ClinicalEntity, and its relationship semantics differ from standard biomedical association edges." ;
    skos:exactMatch okg:MolecularSubtypeRelationship ;
    skos:inScheme alskg:alskg-schema .

