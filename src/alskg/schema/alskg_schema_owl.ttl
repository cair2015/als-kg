        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Assay ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:measures_gene_expression_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:measures_gene_expression_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_false_discovery_rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_log_fold_change ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_adjusted_p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ExpressionDirectionEnum ;
            owl:onProperty alskg:has_expression_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Assay ;
            owl:onProperty alskg:differential_expression_measured_by_assay ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ComparatorGroup ;
            owl:onProperty alskg:compares_against ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_p_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_adjusted_p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_derives_from_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:has_log_fold_change ],
        alskg:EvidenceStatement ;
    skos:definition "A differential gene-expression assertion in an ALS context, including direction, comparator, subtype, anatomy, cell type, cohort, sample, assay, dataset, and statistical support. This is the semantic parent for the Neo4j-compatible GeneExpressionContext class." ;
    skos:exactMatch alskg:DifferentialExpressionStatement ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "DER" .

alskg:EvidenceModalityEnum a owl:Class ;
    rdfs:label "EvidenceModalityEnum" ;
    skos:definition "Modality or source type of evidence supporting a statement." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/EvidenceModalityEnum#biomarker>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#clinical>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#computational_prediction>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#database_curated>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#experimental_model>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#genetic>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#literature_curated>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#pathology>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#proteomic>,
        <https://w3id.org/alskg/schema/EvidenceModalityEnum#transcriptomic> .

alskg:GeneBiotypeEnum a owl:Class ;
    rdfs:label "GeneBiotypeEnum" ;
    skos:definition "Gene biotype classifications from HGNC/Ensembl, stored on Gene nodes." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/GeneBiotypeEnum#lncRNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#miRNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#misc_RNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#other>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#protein_coding>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#pseudogene>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#rRNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#snRNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#snoRNA>,
        <https://w3id.org/alskg/schema/GeneBiotypeEnum#tRNA> .

alskg:MolecularSubtype a owl:Class ;
    rdfs:label "MolecularSubtype" ;
    rdfs:subClassOf [ a owl:Restriction ;
