    rdfs:label "expression_context_in_anatomy" ;
    rdfs:domain alskg:GeneExpressionContext ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Neo4j relationship `IN_ANATOMY` from `ECX`/GeneExpressionContext to `ANA`/Anatomy. Links a reified expression context to the tissue or anatomical region where the expression was measured. Optional." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "ANA" ;
    alskg:neo4j_relationship_type "IN_ANATOMY" ;
    alskg:neo4j_start_label "ECX" .

alskg:expression_context_in_molecular_subtype a owl:ObjectProperty ;
    rdfs:label "expression_context_in_molecular_subtype" ;
    rdfs:domain alskg:GeneExpressionContext ;
    rdfs:range alskg:MolecularSubtype ;
    skos:definition "Neo4j relationship `HAS_MOLECULAR_SUBTYPE` from `ECX`/GeneExpressionContext to `MST`/MolecularSubtype. Links a reified expression context to the molecular subtype whose transcriptomic signature the gene contributes to." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "MST" ;
    alskg:neo4j_relationship_type "HAS_MOLECULAR_SUBTYPE" ;
    alskg:neo4j_start_label "ECX" .

alskg:forms_protein_aggregate a owl:ObjectProperty ;
    rdfs:label "forms_protein_aggregate" ;
    rdfs:range alskg:ProteinAggregate ;
    skos:definition "Connects a protein to an aggregate or pathological protein inclusion it forms." ;
    skos:inScheme alskg:alskg-schema .

alskg:gene_interacts_with_gene a owl:ObjectProperty ;
    rdfs:label "gene_interacts_with_gene" ;
    rdfs:domain alskg:Gene ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `INTERACTS_WITH` from `GEN`/Gene to `GEN`/Gene. Generic interaction or annotation-style relationship. Interpret according to the source and node pair; it may indicate interaction, membership, annotation, or functional context." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "GEN" .

alskg:has_assay a owl:ObjectProperty ;
    rdfs:label "has_assay" ;
    rdfs:range alskg:Assay ;
    skos:definition "Connects a study or dataset to an assay used to generate data." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_biomarker a owl:ObjectProperty ;
    rdfs:label "has_biomarker" ;
    rdfs:range alskg:Biomarker ;
    skos:definition "Connects a disease, subtype, mechanism, or observation to a biomarker." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_case_count a owl:DatatypeProperty ;
    rdfs:label "has_case_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of ALS cases or affected individuals represented." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_cohort a owl:ObjectProperty ;
    rdfs:label "has_cohort" ;
    rdfs:range alskg:Cohort ;
    skos:definition "Connects a study or dataset to a cohort." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_confidence_score a owl:DatatypeProperty ;
    rdfs:label "has_confidence_score" ;
    rdfs:range alskg:Probability ;
    skos:definition "Normalized confidence score for an assertion, from 0 to 1." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_control_count a owl:DatatypeProperty ;
    rdfs:label "has_control_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of controls represented." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_dataset a owl:ObjectProperty ;
    rdfs:label "has_dataset" ;
    rdfs:range alskg:Dataset ;
    skos:definition "Connects a study, source, or KG to a dataset." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_drug_action_direction a owl:ObjectProperty ;
    rdfs:label "has_drug_action_direction" ;
    rdfs:range alskg:DrugActionDirectionEnum ;
    skos:definition "Direction or mode of action of a drug on a target or pathway." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_evidence_modality a owl:ObjectProperty ;
    rdfs:label "has_evidence_modality" ;
    rdfs:range alskg:EvidenceModalityEnum ;
    skos:definition "Type of evidence modality supporting a statement." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_evidence_strength a owl:ObjectProperty ;
    rdfs:label "has_evidence_strength" ;
    rdfs:range alskg:EvidenceStrengthEnum ;
    skos:definition "Qualitative strength of evidence supporting an assertion." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_external_reference a owl:ObjectProperty ;
    rdfs:label "has_external_reference" ;
    rdfs:range alskg:ExternalKnowledgeReference ;
    skos:definition "Connects an ALS-KG entity or assertion to a record in an external knowledge source." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_frequency a owl:DatatypeProperty ;
    rdfs:label "has_frequency" ;
    rdfs:range xsd:string ;
    skos:definition "Frequency or prevalence of a phenotype observation, represented as text, category, or value." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_gene a owl:ObjectProperty ;
    rdfs:label "has_gene" ;
    rdfs:range alskg:Gene ;
    skos:definition "Connects an entity to a gene that is involved, measured, associated, or used for definition." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_license a owl:DatatypeProperty ;
    rdfs:label "has_license" ;
    rdfs:range xsd:string ;
    skos:definition "License or reuse terms for a dataset or source." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_mechanism_category a owl:ObjectProperty ;
    rdfs:label "has_mechanism_category" ;
    rdfs:range alskg:PathogenicMechanismEnum ;
    skos:definition "Broad ALS pathogenesis category of a pathogenic mechanism." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_model_system a owl:ObjectProperty ;
    rdfs:label "has_model_system" ;
    rdfs:range alskg:ModelSystem ;
    skos:definition "Connects a statement, study, mechanism, or dataset to an experimental model system." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_molecular_event a owl:ObjectProperty ;
    rdfs:label "has_molecular_event" ;
    rdfs:range alskg:MolecularEvent ;
    skos:definition "Connects a pathogenic mechanism to a molecular event involved in that mechanism." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_object a owl:ObjectProperty ;
    rdfs:label "has_object" ;
    rdfs:range alskg:NamedEntity ;
    skos:definition "Object of an evidence-backed statement." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_onset_stage a owl:ObjectProperty ;
    rdfs:label "has_onset_stage" ;
    rdfs:range alskg:DiseaseStage ;
    skos:definition "Disease stage or timing at which a phenotype or event is observed." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_phenotype a owl:ObjectProperty ;
    rdfs:label "has_phenotype" ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Connects a disease or subtype to a phenotype that is observed in affected individuals." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_predicate a owl:DatatypeProperty ;
    rdfs:label "has_predicate" ;
    rdfs:range xsd:string ;
    skos:definition "Predicate or relationship type asserted by a statement." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_publication_identifier a owl:DatatypeProperty ;
    rdfs:label "has_publication_identifier" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier for a publication, such as PubMed ID or DOI." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_rationale a owl:DatatypeProperty ;
    rdfs:label "has_rationale" ;
    rdfs:range xsd:string ;
    skos:definition "Textual rationale for a drug repurposing hypothesis or scientific assertion." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_repeat_count a owl:DatatypeProperty ;
    rdfs:label "has_repeat_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Repeat count for a repeat expansion when known." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_repeat_motif a owl:DatatypeProperty ;
    rdfs:label "has_repeat_motif" ;
    rdfs:range xsd:string ;
    skos:definition "Repeat motif for a repeat expansion, such as GGGGCC." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_repurposing_status a owl:ObjectProperty ;
    rdfs:label "has_repurposing_status" ;
    rdfs:range alskg:RepurposingStatusEnum ;
    skos:definition "Status of a drug repurposing hypothesis." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_sample a owl:ObjectProperty ;
    rdfs:label "has_sample" ;
    rdfs:range alskg:Sample ;
    skos:definition "Connects a dataset or cohort to a sample." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_sample_type a owl:DatatypeProperty ;
    rdfs:label "has_sample_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of sample or biospecimen, such as postmortem spinal cord, CSF, blood, or iPSC-derived motor neuron." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_sex a owl:ObjectProperty ;
    rdfs:label "has_sex" ;
    rdfs:range alskg:SexEnum ;
    skos:definition "Sex category for a cohort, sample, or observation when reported." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_source a owl:ObjectProperty ;
    rdfs:label "has_source" ;
    rdfs:range alskg:DataSource ;
    skos:definition "Connects an entity or assertion to a data source." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_species a owl:DatatypeProperty ;
    rdfs:label "has_species" ;
    rdfs:range xsd:string ;
    skos:definition "Species context for a sample, assay, model, or observation." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_subject a owl:ObjectProperty ;
    rdfs:label "has_subject" ;
    rdfs:range alskg:NamedEntity ;
    skos:definition "Subject of an evidence-backed statement." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_subtype a owl:ObjectProperty ;
    rdfs:label "has_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects ALS to a clinical, genetic, molecular, pathological, or progression-defined subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_subtype_axis a owl:ObjectProperty ;
    rdfs:label "has_subtype_axis" ;
    rdfs:range alskg:SubtypeAxisEnum ;
    skos:definition "Indicates the main axis used to define a subtype." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_title a owl:DatatypeProperty ;
    rdfs:label "has_title" ;
    rdfs:range xsd:string ;
    skos:definition "Title of a publication, dataset, study, or trial." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_url a owl:DatatypeProperty ;
    rdfs:label "has_url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL for a web page, dataset, source, or documentation page." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_variant_consequence a owl:ObjectProperty ;
    rdfs:label "has_variant_consequence" ;
    rdfs:range alskg:VariantConsequenceEnum ;
    skos:definition "Sequence or molecular consequence of a variant." ;
    skos:inScheme alskg:alskg-schema .

alskg:has_year a owl:DatatypeProperty ;
    rdfs:label "has_year" ;
    rdfs:range xsd:integer ;
    skos:definition "Year of publication, release, or study." ;
    skos:inScheme alskg:alskg-schema .

alskg:involves_pathway a owl:ObjectProperty ;
    rdfs:label "involves_pathway" ;
    rdfs:range alskg:Pathway ;
    skos:definition "Connects a mechanism, gene, subtype, or statement to a pathway." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_biomarker_for a owl:ObjectProperty ;
    rdfs:label "is_biomarker_for" ;
    rdfs:range alskg:NamedEntity ;
    skos:definition "Connects a biomarker to the disease, subtype, mechanism, progression pattern, or response it indicates." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_defined_by_phenotype a owl:ObjectProperty ;
    rdfs:label "is_defined_by_phenotype" ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Connects a subtype to a clinical phenotype used in its definition." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_indicated_for_subtype a owl:ObjectProperty ;
    rdfs:label "is_indicated_for_subtype" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a therapy to an ALS subtype for which it is indicated or hypothesized to be relevant." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_sample_from a owl:ObjectProperty ;
    rdfs:label "is_sample_from" ;
    rdfs:range alskg:Cohort ;
    skos:definition "Connects a sample to the cohort or participant group from which it was collected." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_sampled_from_anatomy a owl:ObjectProperty ;
    rdfs:label "is_sampled_from_anatomy" ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Connects a sample to the anatomical structure or tissue from which it was derived." ;
    skos:inScheme alskg:alskg-schema .

alskg:is_sampled_from_cell_type a owl:ObjectProperty ;
    rdfs:label "is_sampled_from_cell_type" ;
    rdfs:range alskg:CellType ;
    skos:definition "Connects a sample to the cell type from which it was derived or enriched." ;
    skos:inScheme alskg:alskg-schema .

alskg:molecular_event_contributes_to_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "molecular_event_contributes_to_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a molecular event to the pathogenic mechanism it contributes to." ;
    skos:inScheme alskg:alskg-schema .

alskg:molecular_function_enabled_by_gene a owl:ObjectProperty ;
    rdfs:label "molecular_function_enabled_by_gene" ;
    rdfs:domain alskg:MolecularFunction ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `INTERACTS_WITH` from MolecularFunction to Gene. Semantic view: the gene/gene product enables or is annotated to the molecular function." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "MFN" .

alskg:molecular_function_is_subclass_of a owl:ObjectProperty ;
    rdfs:label "molecular_function_is_subclass_of" ;
    rdfs:domain alskg:MolecularFunction ;
    rdfs:range alskg:MolecularFunction ;
    skos:definition "Current OptimusKG Neo4j relationship `IS_A` from `MFN`/MolecularFunction to `MFN`/MolecularFunction. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "MFN" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "MFN" .

alskg:molecular_subtype_has_parent_disease a owl:ObjectProperty ;
    rdfs:label "molecular_subtype_has_parent_disease" ;
    rdfs:domain alskg:MolecularSubtype ;
    rdfs:range alskg:Disease ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `MST`/MolecularSubtype to `DIS`/Disease. Hierarchical linkage from a molecular subtype to its anchor disease node (e.g. ALS-Ox -> ALS general, MONDO:0004976). Uses the existing PARENT relationship type for compatibility with DIS hierarchy traversal." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "MST" .

alskg:molecular_subtype_measured_in_anatomy a owl:ObjectProperty ;
    rdfs:label "molecular_subtype_measured_in_anatomy" ;
    rdfs:domain alskg:MolecularSubtype ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Current OptimusKG Neo4j relationship `MEASURED_IN` from `MST`/MolecularSubtype to `ANA`/Anatomy. Indicates the tissue or anatomical context in which the molecular subtype was characterized (e.g. motor cortex, spinal cord)." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "ANA" ;
    alskg:neo4j_relationship_type "MEASURED_IN" ;
    alskg:neo4j_start_label "MST" .

alskg:observes_phenotype a owl:ObjectProperty ;
    rdfs:label "observes_phenotype" ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Connects a phenotype observation to the phenotype observed." ;
    skos:inScheme alskg:alskg-schema .

alskg:pathway_has_member_gene a owl:ObjectProperty ;
    rdfs:label "pathway_has_member_gene" ;
    rdfs:domain alskg:Pathway ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `INTERACTS_WITH` from Pathway to Gene. Semantic view: the pathway has the gene/gene product as a member or participant." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "PWY" .

alskg:pathway_has_parent_pathway a owl:ObjectProperty ;
    rdfs:label "pathway_has_parent_pathway" ;
    rdfs:domain alskg:Pathway ;
    rdfs:range alskg:Pathway ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `PWY`/Pathway to `PWY`/Pathway. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "PWY" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PWY" .

alskg:phenotype_associated_with_gene a owl:ObjectProperty ;
    rdfs:label "phenotype_associated_with_gene" ;
    rdfs:domain alskg:Phenotype ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `ASSOCIATED_WITH` from `PHE`/Phenotype to `GEN`/Gene. Association relationship; generally evidence-bearing but not necessarily causal." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "ASSOCIATED_WITH" ;
    alskg:neo4j_start_label "PHE" .

alskg:phenotype_has_parent_disease a owl:ObjectProperty ;
    rdfs:label "phenotype_has_parent_disease" ;
    rdfs:domain alskg:Phenotype ;
    rdfs:range alskg:Disease ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `PHE`/Phenotype to `DIS`/Disease. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PHE" .

alskg:phenotype_has_parent_phenotype a owl:ObjectProperty ;
    rdfs:label "phenotype_has_parent_phenotype" ;
    rdfs:domain alskg:Phenotype ;
    rdfs:range alskg:Phenotype ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `PHE`/Phenotype to `PHE`/Phenotype. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "PHE" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PHE" .

alskg:protein_contributes_to_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "protein_contributes_to_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a protein to an ALS pathogenic mechanism it contributes to." ;
    skos:inScheme alskg:alskg-schema .

alskg:tested_in_trial a owl:ObjectProperty ;
    rdfs:label "tested_in_trial" ;
    rdfs:range alskg:ClinicalTrial ;
    skos:definition "Connects a drug, therapy, or hypothesis to a clinical trial." ;
    skos:inScheme alskg:alskg-schema .

alskg:treats_disease a owl:ObjectProperty ;
    rdfs:label "treats_disease" ;
    rdfs:range alskg:Disease ;
    skos:definition "Connects a drug or therapeutic intervention to a disease it treats or is hypothesized to treat." ;
    skos:inScheme alskg:alskg-schema .

alskg:undirected a owl:DatatypeProperty ;
    rdfs:label "undirected" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the relationship has no intrinsic directionality in the OptimusKG export, when available." ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSKGExtensionGraph a owl:Class ;
    rdfs:label "ALSKGExtensionGraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        alskg:AnalyticalEntity ;
    skos:definition "Optional container class representing ALS-specific nodes and relationships added on top of an OptimusKG Neo4j graph." ;
    skos:exactMatch alskg:ALSKGExtensionGraph ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSSubtypeAffectsAnatomyRelationship a owl:Class ;
    rdfs:label "ALSSubtypeAffectsAnatomyRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        alskg:ALSPathogenesisRelationship ;
    skos:definition "Connects an ALS subtype to an affected anatomical structure." ;
    skos:exactMatch alskg:ALSSubtypeAffectsAnatomyRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "als_subtype_affects_anatomy" ;
    alskg:neo4j_relationship_type "AFFECTS_ANATOMY" ;
    alskg:semantic_view_note "ALS-KG extension relationship proposed for Neo4j materialization; does not replace current OptimusKG relationships." .

alskg:ALSSubtypeDefinedByGeneRelationship a owl:Class ;
    rdfs:label "ALSSubtypeDefinedByGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:subject ],
        alskg:ALSSubtypeRelationship ;
    skos:definition "Connects an ALS subtype to a defining or characteristic gene." ;
    skos:exactMatch alskg:ALSSubtypeDefinedByGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "als_subtype_defined_by_gene" ;
