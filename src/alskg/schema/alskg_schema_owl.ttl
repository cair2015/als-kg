        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:measures_gene_expression_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:occurs_in_subtype_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:differential_expression_occurs_in_subtype ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:has_adjusted_p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:differential_expression_measures_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellType ;
            owl:onProperty alskg:occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellType ;
            owl:onProperty alskg:differential_expression_occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:differential_expression_occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:differential_expression_measures_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:occurs_in_disease_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
