    skos:definition "Drug modulates the target without specifying direction." .

<https://w3id.org/alskg/schema/DrugActionDirectionEnum#stabilizes> a owl:NamedIndividual, alskg:DrugActionDirectionEnum ;
    rdfs:label "stabilizes" ;
    skos:definition "Drug stabilizes the target, complex, or functional state." .

<https://w3id.org/alskg/schema/DrugActionDirectionEnum#unknown> a owl:NamedIndividual, alskg:DrugActionDirectionEnum ;
    rdfs:label "unknown" ;
    skos:definition "Drug action is not specified." .

<https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#ab> a owl:NamedIndividual, alskg:DrugTractabilityModalityEnum ;
    rdfs:label "ab" ;
    skos:definition "Antibody modality" .

<https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#oc> a owl:NamedIndividual, alskg:DrugTractabilityModalityEnum ;
    rdfs:label "oc" ;
    skos:definition "Other clinical modality" .

<https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#pr> a owl:NamedIndividual, alskg:DrugTractabilityModalityEnum ;
    rdfs:label "pr" ;
    skos:definition "PROTAC (protein degrader) modality" .

<https://w3id.org/alskg/schema/DrugTractabilityModalityEnum#sm> a owl:NamedIndividual, alskg:DrugTractabilityModalityEnum ;
    rdfs:label "sm" ;
    skos:definition "Small molecule modality" .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#biomarker> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "biomarker" ;
    skos:definition "Evidence from molecular, imaging, electrophysiological, or clinical biomarkers." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#clinical> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "clinical" ;
    skos:definition "Evidence from clinical observations, examinations, diagnostic records, or clinical cohorts." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#computational_prediction> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "computational_prediction" ;
    skos:definition "Evidence generated by computational model, embedding, machine learning, or algorithmic inference." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#database_curated> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "database_curated" ;
    skos:definition "Evidence curated from a database or knowledge base." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#experimental_model> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "experimental_model" ;
    skos:definition "Evidence from animal, cell, iPSC, organoid, or other model systems." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#genetic> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "genetic" ;
    skos:definition "Evidence from genetic association, segregation, variant interpretation, or sequencing studies." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#literature_curated> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "literature_curated" ;
    skos:definition "Evidence curated from scientific literature." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#pathology> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "pathology" ;
    skos:definition "Evidence from histology, immunostaining, digital pathology, or neuropathological assessment." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#proteomic> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "proteomic" ;
    skos:definition "Evidence from protein abundance, localization, aggregation, or post-translational modification assays." .

<https://w3id.org/alskg/schema/EvidenceModalityEnum#transcriptomic> a owl:NamedIndividual, alskg:EvidenceModalityEnum ;
    rdfs:label "transcriptomic" ;
    skos:definition "Evidence from RNA-seq, single-cell RNA-seq, spatial transcriptomics, microarray, or related assays." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#conflicting> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "conflicting" ;
    skos:definition "Evidence is inconsistent across studies or modalities." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#definitive> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "definitive" ;
    skos:definition "Strongly supported by replicated, high-quality evidence or accepted clinical/genetic evidence." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#moderate> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "moderate" ;
    skos:definition "Supported by some evidence, but with limitations or limited replication." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#strong> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "strong" ;
    skos:definition "Supported by substantial evidence from curated, experimental, or replicated sources." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#unknown> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "unknown" ;
    skos:definition "Evidence strength has not been assessed." .

<https://w3id.org/alskg/schema/EvidenceStrengthEnum#weak> a owl:NamedIndividual, alskg:EvidenceStrengthEnum ;
    rdfs:label "weak" ;
    skos:definition "Supported by limited or preliminary evidence." .

<https://w3id.org/alskg/schema/ExpressionCallQualityEnum#gold> a owl:NamedIndividual, alskg:ExpressionCallQualityEnum ;
    rdfs:label "gold" ;
    skos:definition "High-confidence expression call (multiple concordant evidence types)" .

<https://w3id.org/alskg/schema/ExpressionCallQualityEnum#silver> a owl:NamedIndividual, alskg:ExpressionCallQualityEnum ;
    rdfs:label "silver" ;
    skos:definition "Moderate-confidence expression call" .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#DOWN> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "DOWN" ;
    skos:definition "Gene or feature is downregulated (lower expression) in the molecular subtype compared to non-ALS controls." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#UP> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "UP" ;
    skos:definition "Gene or feature is upregulated (higher expression) in the molecular subtype compared to non-ALS controls." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#decreased> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "decreased" ;
    skos:definition "Expression is lower in the case or condition group than in the comparator group." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#increased> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "increased" ;
    skos:definition "Expression is higher in the case or condition group than in the comparator group." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#mixed> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "mixed" ;
    skos:definition "Direction differs across cohorts, cell types, tissues, assays, or analytical methods." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#unchanged> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "unchanged" ;
    skos:definition "No statistically meaningful expression change is observed." .

<https://w3id.org/alskg/schema/ExpressionDirectionEnum#unknown> a owl:NamedIndividual, alskg:ExpressionDirectionEnum ;
    rdfs:label "unknown" ;
    skos:definition "Direction is not specified or cannot be determined." .

alskg:ExternalKnowledgeReference a owl:Class ;
    rdfs:label "ExternalKnowledgeReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        alskg:ProvenanceEntity ;
    skos:definition "A reference to an entity, assertion, or record in an external knowledge graph or database, such as OptimusKG, PrimeKG, Open Targets, or a source dataset." ;
    skos:exactMatch alskg:ExternalKnowledgeReference ;
    skos:inScheme alskg:alskg-schema .

