<https://w3id.org/alskg/schema/RelationshipTypeEnum#HAS_EXPRESSION_CONTEXT> a owl:NamedIndividual, alskg:RelationshipTypeEnum ;
    rdfs:label "HAS_EXPRESSION_CONTEXT" ;
