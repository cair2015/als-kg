            owl:onProperty alskg:pubmed_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:defining_mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:tissue_origin ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:prevalence_pct ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:key_pathways ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:classification_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:classification_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:onset_age_mean ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:full_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:survival_months_median ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:survival_months_median ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:full_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularSubtypeClassificationBasisEnum ;
            owl:onProperty alskg:classification_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:prevalence_pct ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:expected_subtype_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:label_color ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:onset_age_mean ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:full_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:key_pathways ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:computational_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:defining_mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:prognosis_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:label_color ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:cohort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:label_color ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:expected_subtype_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:tissue_origin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:prognosis_note ],
        alskg:ALSSubtype ;
    skos:definition "A molecular ALS subtype defined by transcriptomic, multi-omic, pathology-associated, or computational evidence. This class preserves compatibility with the current Neo4j `MST` label while making MolecularSubtype a proper subclass of ALSSubtype." ;
    skos:exactMatch alskg:MolecularSubtype ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "MST" .

alskg:SubtypeClassificationOriginEnum a owl:Class ;
    rdfs:label "SubtypeClassificationOriginEnum" ;
    skos:definition "Origin or derivation method for an ALS subtype. Distinguishes clinically and ontologically defined subtypes from those derived computationally via machine learning or multi-omics analysis. Used on ALSSubtype.classification_origin." ;
    skos:inScheme alskg:alskg-schema ;
    linkml:permissible_values <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#clinical>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#clinical_ml>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#epigenomic_ml>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#genomic>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#multiomics_ml>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#ontological>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#pathological>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#proteomic_ml>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#transcriptomic_ml>,
        <https://w3id.org/alskg/schema/SubtypeClassificationOriginEnum#unknown> .

alskg:DataSource a owl:Class ;
    rdfs:label "DataSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:source_type ],
        alskg:ProvenanceEntity ;
    skos:definition "A database, data resource, or source vocabulary contributing identifiers, evidence, or assertions to OptimusKG." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme alskg:alskg-schema .

alskg:ExpressionDirectionEnum a owl:Class ;
    rdfs:label "ExpressionDirectionEnum" ;
    skos:definition "Direction of differential expression relative to a comparator. Includes legacy OptimusKG values UP/DOWN and semantic ALS-KG values increased/decreased/unchanged/mixed/unknown." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/ExpressionDirectionEnum#DOWN>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#UP>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#decreased>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#increased>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#mixed>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#unchanged>,
        <https://w3id.org/alskg/schema/ExpressionDirectionEnum#unknown> .

alskg:synonyms a owl:DatatypeProperty ;
    rdfs:label "synonyms" ;
    rdfs:range xsd:string ;
    skos:definition "Alternative names or synonyms." ;
    skos:inScheme alskg:alskg-schema .

alskg:ALSPathogenesisRelationship a owl:Class ;
    rdfs:label "ALSPathogenesisRelationship" ;
    rdfs:subClassOf alskg:ALSRelationship ;
    skos:definition "Relationships connecting genes, variants, proteins, subtypes, mechanisms, cell types, and anatomy in ALS pathogenesis." ;
    skos:exactMatch alskg:ALSPathogenesisRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:BiologicalProcess a owl:Class ;
    rdfs:label "BiologicalProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:ontology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:synonyms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:definition ],
        alskg:OntologyClass ;
    skos:definition """A Gene Ontology biological process term represented in OptimusKG. Current Neo4j label: `BPO`.

Property detail from OptimusKG source schema: A Gene Ontology (GO) biological process node. Represents 25,754 biological processes (13.5% of nodes) describing coordinated programs of molecular activities with a defined beginning and end (e.g. "apoptotic process", "DNA repair", "cell division"). Source: Gene Ontology (GO). Node file: nodes/biological_process.parquet""" ;
    skos:exactMatch biolink:BiologicalProcess ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "BPO" ;
    alskg:optimus_abbreviation "BPO" ;
    alskg:property_schema_source "BiologicalProcessNode" .

alskg:NamedEntity a owl:Class ;
    rdfs:label "NamedEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:direct_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:indirect_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:indirect_sources ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:direct_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:NodeLabelEnum ;
            owl:onProperty alskg:original_optimus_label ] ;
    skos:definition "Root abstract class for all named entities in OptimusKG. Replaces the former BiomedicalEntity root (v0.3.0). Provides core identity slots shared across all four mid-tier branches: OntologyClass, ClinicalEntity, PhysicalEntity, and AnalyticalEntity." ;
    skos:exactMatch biolink:NamedThing ;
    skos:inScheme alskg:alskg-schema .

alskg:ProvenanceEntity a owl:Class ;
    rdfs:label "ProvenanceEntity" ;
    skos:definition "Abstract root for schema infrastructure and provenance records. Subclasses document the origin, identity, and evidence lineage of graph content without themselves being biomedical knowledge entities. Replaces the former SemanticEntity grouping for non-entity classes. Children: DataSource, Publication, DatabaseAccession (+ CrossReference), Synonym." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme alskg:alskg-schema .

alskg:SequenceVariant a owl:Class ;
    rdfs:label "SequenceVariant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:variant_alters_protein ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:variant_affects_gene ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_pathogenicity ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Protein ;
            owl:onProperty alskg:alters_protein ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:variant_alters_protein ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:affects_gene ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:has_variant_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:affects_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:alters_protein ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_variant_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:variant_affects_gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicityEnum ;
            owl:onProperty alskg:has_pathogenicity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:has_variant_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:variant_affects_gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Protein ;
            owl:onProperty alskg:variant_alters_protein ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_pathogenicity ],
        alskg:PhysicalEntity ;
    skos:definition "A genomic sequence variant relevant to ALS, including SNVs, indels, structural variants, copy number changes, and repeat expansions." ;
    skos:exactMatch SO:0001060 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "VAR" .

alskg:xrefs a owl:DatatypeProperty ;
    rdfs:label "xrefs" ;
    rdfs:range xsd:string ;
    skos:definition "Cross-references to external resources." ;
    skos:inScheme alskg:alskg-schema .

alskg:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    rdfs:range xsd:string ;
    skos:definition "Formal textual definition." ;
    skos:inScheme alskg:alskg-schema .

alskg:EvidenceRecord a owl:Class ;
    rdfs:label "EvidenceRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:DataSource ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:evidence_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_publication ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:evidence_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:from_data_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty alskg:confidence_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:evidence_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Publication ;
            owl:onProperty alskg:has_publication ],
        alskg:ProvenanceEntity ;
    skos:definition "A structured evidence item supporting a node, relationship, or knowledge statement in the semantic view." ;
    skos:exactMatch biolink:EvidenceType ;
    skos:inScheme alskg:alskg-schema .

alskg:Exposure a owl:Class ;
    rdfs:label "Exposure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source_categories ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:source_details ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:source_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:source_details ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:source_details ],
        alskg:PhysicalEntity ;
    skos:definition """An environmental, chemical, lifestyle, or other exposure concept represented in OptimusKG. Current Neo4j label: `EXP`.

Property detail from OptimusKG source schema: A chemical, physical, or environmental exposure node. Represents 881 exposures (0.5% of nodes) linked to biological outcomes via CTD (Comparative Toxicogenomics Database). Covers chemical exposures, physical agents, dietary factors, and lifestyle exposures. Source: Comparative Toxicogenomics Database (CTD). Node file: nodes/exposure.parquet""" ;
    skos:exactMatch biolink:EnvironmentalExposure ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "EXP" ;
    alskg:optimus_abbreviation "EXP" ;
    alskg:property_schema_source "ExposureNode" .

alskg:DrugGeneModulationRelationship a owl:Class ;
    rdfs:label "DrugGeneModulationRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Drug ;
            owl:onProperty alskg:subject ],
        alskg:DrugGeneRelationship ;
    skos:definition "Drug-gene relationship indicating that the drug changes the activity, abundance, state, opening, stability, degradation, release, or function of the gene product." ;
    skos:exactMatch okg:DrugGeneModulationRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:occurs_in_disease_context a owl:ObjectProperty ;
    rdfs:label "occurs_in_disease_context" ;
    rdfs:range alskg:Disease ;
    skos:definition "Connects a statement or result to its disease context." ;
    skos:inScheme alskg:alskg-schema .

alskg:occurs_in_subtype_context a owl:ObjectProperty ;
    rdfs:label "occurs_in_subtype_context" ;
    rdfs:range alskg:ALSSubtype ;
    skos:definition "Connects a statement or result to its ALS subtype context." ;
    skos:inScheme alskg:alskg-schema .

alskg:ontology a owl:ObjectProperty ;
    rdfs:label "ontology" ;
    rdfs:range alskg:OntologyMetadata ;
    skos:definition "Metadata about the source ontology." ;
    skos:inScheme alskg:alskg-schema .

alskg:PathogenicMechanismEnum a owl:Class ;
    rdfs:label "PathogenicMechanismEnum" ;
    skos:definition "Major ALS pathogenic mechanism categories." ;
    skos:inScheme alskg:alskg-enums ;
    linkml:permissible_values <https://w3id.org/alskg/schema/PathogenicMechanismEnum#C9orf72_repeat_toxicity>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#DNA_repair_defect>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#FUS_proteinopathy>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#RNA_processing_dysfunction>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#SOD1_toxicity>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#TDP43_proteinopathy>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#axonal_transport_defect>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#glutamate_excitotoxicity>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#impaired_proteostasis>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#metabolic_dysfunction>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#mitochondrial_dysfunction>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#neuroinflammation>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#neuromuscular_junction_dysfunction>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#nucleocytoplasmic_transport_defect>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#other>,
        <https://w3id.org/alskg/schema/PathogenicMechanismEnum#oxidative_stress> .

