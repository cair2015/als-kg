alskg:AnatomyGeneExpressionRelationship a owl:Class ;
    rdfs:label "AnatomyGeneExpressionRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty alskg:expression_rank ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:call_quality ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ExpressionCallQualityEnum ;
            owl:onProperty alskg:call_quality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:subject ],
