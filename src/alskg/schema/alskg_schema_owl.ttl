        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty alskg:ontology ],
        alskg:OntologyClass ;
    skos:definition """An anatomical entity or anatomical region represented in OptimusKG. Current Neo4j label: `ANA`.

Property detail from OptimusKG source schema: An anatomical structure or tissue node. Represents 13,120 anatomical entities (6.9% of nodes) from the Uberon cross-species anatomy ontology. Covers organs, tissues, cell types, developmental structures, and systems. Source: Uberon. Node file: nodes/anatomy.parquet""" ;
    skos:exactMatch biolink:AnatomicalEntity ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_label "ANA" ;
    alskg:optimus_abbreviation "ANA" ;
    alskg:property_schema_source "AnatomyNode" .

