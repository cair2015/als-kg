    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "GEN" .

alskg:MolecularFunctionEnabledByGeneRelationship a owl:Class ;
    rdfs:label "MolecularFunctionEnabledByGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularFunction ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        alskg:FunctionalAnnotationRelationship ;
    skos:definition "A molecular-function-to-gene relationship corresponding to Neo4j `(:MolecularFunction)-[:INTERACTS_WITH]->(:Gene)`. In the semantic view, interpret as the gene/gene product enabling or being annotated to the molecular function." ;
    skos:exactMatch okg:MolecularFunctionInteractsWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "molecularfunction_interacts_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "MFN" .

alskg:MolecularFunctionIsSubclassOfRelationship a owl:Class ;
    rdfs:label "MolecularFunctionIsSubclassOfRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularFunction ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularFunction ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:MFN)-[:IS_A]->(:MFN)`, represented with full class names as MolecularFunction -> MolecularFunction. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:exactMatch okg:MolecularFunctionIsAMolecularFunctionRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "molecularfunction_is_a_molecularfunction" ;
    alskg:neo4j_end_label "MFN" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "MFN" .

alskg:MolecularSubtypeHasParentDiseaseRelationship a owl:Class ;
    rdfs:label "MolecularSubtypeHasParentDiseaseRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularSubtype ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the Neo4j pattern `(:MST)-[:PARENT]->(:DIS)`, represented with full class names as MolecularSubtype -> Disease. Anchors a molecular subtype node to its parent disease in the knowledge graph hierarchy. Reuses the existing PARENT relationship type for compatibility with disease DAG traversal patterns." ;
    skos:exactMatch okg:MolecularSubtypeParentDiseaseRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "molecular_subtype_has_parent_disease" ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "MST" ;
    alskg:semantic_view_note "Reuses PARENT relationship type for MST->DIS edges; semantically means the molecular subtype is grouped under its anchor disease node in the hierarchy." .

alskg:MolecularSubtypeMeasuredInAnatomyRelationship a owl:Class ;
    rdfs:label "MolecularSubtypeMeasuredInAnatomyRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:MolecularSubtype ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        alskg:MolecularSubtypeRelationship ;
    skos:definition "Reified schema class for the Neo4j pattern `(:MST)-[:MEASURED_IN]->(:ANA)`, represented with full class names as MolecularSubtype -> Anatomy. Indicates the tissue context in which a molecular subtype was characterized (e.g. motor cortex, spinal cord). ALS-TE is cortex-only in the current NYGC dataset; ALS-Ox and ALS-Glia have both cortex and cord characterizations." ;
    skos:exactMatch okg:MolecularSubtypeMeasuredInAnatomyRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "molecular_subtype_measured_in_anatomy" ;
    alskg:neo4j_end_label "ANA" ;
    alskg:neo4j_relationship_type "MEASURED_IN" ;
    alskg:neo4j_start_label "MST" .

alskg:PathwayHasMemberGeneRelationship a owl:Class ;
    rdfs:label "PathwayHasMemberGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Pathway ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        alskg:FunctionalAnnotationRelationship ;
    skos:definition "A pathway-to-gene relationship corresponding to Neo4j `(:Pathway)-[:INTERACTS_WITH]->(:Gene)`. In the semantic view, interpret as pathway membership/participation rather than a generic interaction." ;
    skos:exactMatch okg:PathwayInteractsWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "pathway_interacts_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "PWY" .

alskg:PathwayHasParentPathwayRelationship a owl:Class ;
    rdfs:label "PathwayHasParentPathwayRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Pathway ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Pathway ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        alskg:HierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:PWY)-[:PARENT]->(:PWY)`, represented with full class names as Pathway -> Pathway. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:exactMatch okg:PathwayParentPathwayRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "pathway_parent_pathway" ;
    alskg:neo4j_end_label "PWY" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PWY" .

alskg:PhenotypeAssociatedWithGeneRelationship a owl:Class ;
    rdfs:label "PhenotypeAssociatedWithGeneRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Gene ;
            owl:onProperty alskg:object ],
        alskg:AssociationRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:PHE)-[:ASSOCIATED_WITH]->(:GEN)`, represented with full class names as Phenotype -> Gene. Association relationship; generally evidence-bearing but not necessarily causal." ;
    skos:exactMatch okg:PhenotypeAssociatedWithGeneRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "phenotype_associated_with_gene" ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "ASSOCIATED_WITH" ;
    alskg:neo4j_start_label "PHE" .

alskg:PhenotypeHasParentDiseaseRelationship a owl:Class ;
    rdfs:label "PhenotypeHasParentDiseaseRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:subject ],
        alskg:PhenotypeHierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:PHE)-[:PARENT]->(:DIS)`, represented with full class names as Phenotype -> Disease. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:exactMatch okg:PhenotypeParentDiseaseRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "phenotype_parent_disease" ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PHE" .

alskg:PhenotypeHasParentPhenotypeRelationship a owl:Class ;
    rdfs:label "PhenotypeHasParentPhenotypeRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:original_optimus_relationship_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:object ],
        alskg:PhenotypeHierarchyRelationship ;
    skos:definition "Reified schema class for the current Neo4j pattern `(:PHE)-[:PARENT]->(:PHE)`, represented with full class names as Phenotype -> Phenotype. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:exactMatch okg:PhenotypeParentPhenotypeRelationship ;
    skos:inScheme alskg:alskg-schema ;
    alskg:direct_slot "phenotype_parent_phenotype" ;
    alskg:neo4j_end_label "PHE" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "PHE" .

alskg:RepeatExpansion a owl:Class ;
    rdfs:label "RepeatExpansion" ;
    rdfs:subClassOf alskg:SequenceVariant ;
    skos:definition "A repeat expansion variant, such as the C9orf72 hexanucleotide repeat expansion associated with ALS/FTD." ;
    skos:exactMatch SO:0002165 ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "REX" .

alskg:Sources a owl:Class ;
    rdfs:label "Sources" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:indirect ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:indirect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty alskg:direct ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:direct ],
        alskg:ProvenanceEntity ;
    skos:definition "Provenance tracking struct present on every node and edge in OptimusKG. Distinguishes between datasets that directly contributed the entity (primary ingestors) and those referenced indirectly through aggregators. Example direct sources: Open Targets, DisGeNET, Bgee. Example indirect sources: ClinGen, PsyGeNET, UniProt (via Open Targets)." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:source_schema "optimuskg_schema.yaml" .

alskg:alskg-schema.owl.ttl a owl:Ontology ;
    rdfs:label "alskg_schema" ;
    dcterms:license "MIT" ;
    dcterms:title "ALSKG Schema Extending OptimusKG" ;
    pav:version "0.4.0-alskg" ;
    rdfs:seeAlso <https://arxiv.org/abs/2604.27269>,
        <https://doi.org/10.7910/DVN/IYNGEV>,
        <https://github.com/mims-harvard/optimuskg>,
        <https://optimuskg.ai>,
        <https://optimuskg.ai/docs/graph-schema/edges>,
        <https://optimuskg.ai/docs/graph-schema/nodes> ;
    skos:definition "A LinkML schema for ALSKG that extends the OptimusKG semantic model while preserving Neo4j-compatible node classes, relationship classes, and graph semantics. It adds ALS-focused classes and relationships for subtypes, variants, pathogenesis, gene expression, cohorts, samples, assays, evidence, biomarkers, model systems, therapy, and drug repurposing." ;
    alskg:schema_role "semantic_view" ;
    alskg:standalone_schema "true" .

alskg:anatomy_has_gene_expression_absent a owl:ObjectProperty ;
    rdfs:label "anatomy_has_gene_expression_absent" ;
    rdfs:domain alskg:Anatomy ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `EXPRESSION_ABSENT` from Anatomy to Gene. Means expression of the gene is reported absent in the anatomical entity." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "EXPRESSION_ABSENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:anatomy_has_gene_expression_present a owl:ObjectProperty ;
    rdfs:label "anatomy_has_gene_expression_present" ;
    rdfs:domain alskg:Anatomy ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `EXPRESSION_PRESENT` from Anatomy to Gene. Means expression of the gene is reported present in the anatomical entity." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "EXPRESSION_PRESENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:anatomy_has_parent_anatomy a owl:ObjectProperty ;
    rdfs:label "anatomy_has_parent_anatomy" ;
    rdfs:domain alskg:Anatomy ;
    rdfs:range alskg:Anatomy ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `ANA`/Anatomy to `ANA`/Anatomy. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "ANA" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "ANA" .

alskg:biological_process_has_participating_gene a owl:ObjectProperty ;
    rdfs:label "biological_process_has_participating_gene" ;
    rdfs:domain alskg:BiologicalProcess ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `INTERACTS_WITH` from BiologicalProcess to Gene. Semantic view: the gene is annotated to or participates in the biological process; use provenance/evidence to avoid overinterpreting as a physical interaction." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "BPO" .

alskg:biological_process_is_subclass_of a owl:ObjectProperty ;
    rdfs:label "biological_process_is_subclass_of" ;
    rdfs:domain alskg:BiologicalProcess ;
    rdfs:range alskg:BiologicalProcess ;
    skos:definition "Current OptimusKG Neo4j relationship `IS_A` from `BPO`/BiologicalProcess to `BPO`/BiologicalProcess. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "BPO" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "BPO" .

alskg:biomarker_indicates_pathogenic_mechanism a owl:ObjectProperty ;
    rdfs:label "biomarker_indicates_pathogenic_mechanism" ;
    rdfs:range alskg:PathogenicMechanism ;
    skos:definition "Connects a biomarker to a pathogenic mechanism it indicates." ;
    skos:inScheme alskg:alskg-schema .

alskg:cellular_component_has_located_gene a owl:ObjectProperty ;
    rdfs:label "cellular_component_has_located_gene" ;
    rdfs:domain alskg:CellularComponent ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `INTERACTS_WITH` from CellularComponent to Gene. Semantic view: the gene/gene product is annotated as located in or associated with the cellular component." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "INTERACTS_WITH" ;
    alskg:neo4j_start_label "CCO" .

alskg:cellular_component_is_subclass_of a owl:ObjectProperty ;
    rdfs:label "cellular_component_is_subclass_of" ;
    rdfs:domain alskg:CellularComponent ;
    rdfs:range alskg:CellularComponent ;
    skos:definition "Current OptimusKG Neo4j relationship `IS_A` from `CCO`/CellularComponent to `CCO`/CellularComponent. Ontology subclass relationship indicating the source concept is a kind of the target concept." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "CCO" ;
    alskg:neo4j_relationship_type "IS_A" ;
    alskg:neo4j_start_label "CCO" .

alskg:comes_from_data_source a owl:ObjectProperty ;
    rdfs:label "comes_from_data_source" ;
    rdfs:range alskg:DataSource ;
    skos:definition "Connects a database accession, dataset, or record to the source that issued it." ;
    skos:inScheme alskg:alskg-schema .

alskg:disease_associated_with_gene a owl:ObjectProperty ;
    rdfs:label "disease_associated_with_gene" ;
    rdfs:domain alskg:Disease ;
    rdfs:range alskg:Gene ;
    skos:definition "Current OptimusKG Neo4j relationship `ASSOCIATED_WITH` from `DIS`/Disease to `GEN`/Gene. Association relationship; generally evidence-bearing but not necessarily causal." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "GEN" ;
    alskg:neo4j_relationship_type "ASSOCIATED_WITH" ;
    alskg:neo4j_start_label "DIS" .

alskg:disease_has_parent_disease a owl:ObjectProperty ;
    rdfs:label "disease_has_parent_disease" ;
    rdfs:domain alskg:Disease ;
    rdfs:range alskg:Disease ;
    skos:definition "Current OptimusKG Neo4j relationship `PARENT` from `DIS`/Disease to `DIS`/Disease. Parent-child hierarchy relationship from the source concept to a broader or parent concept in the same or related ontology." ;
    skos:inScheme alskg:alskg-schema ;
    alskg:neo4j_end_label "DIS" ;
    alskg:neo4j_relationship_type "PARENT" ;
    alskg:neo4j_start_label "DIS" .

alskg:disease_has_phenotype a owl:ObjectProperty ;
    rdfs:label "disease_has_phenotype" ;
