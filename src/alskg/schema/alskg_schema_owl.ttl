alskg:Biomarker a owl:Class ;
    rdfs:label "Biomarker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:biomarker_for_disease ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Assay ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:measured_by_assay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:biomarker_for_disease ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:indicates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:PathogenicMechanism ;
            owl:onProperty alskg:indicates_pathogenic_mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:ALSSubtype ;
            owl:onProperty alskg:biomarker_for_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:biomarker_for_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        alskg:ClinicalEntity ;
    skos:definition "A molecular, imaging, electrophysiological, pathological, or clinical biomarker relevant to ALS diagnosis, subtype, prognosis, progression, mechanism, or therapeutic response." ;
    skos:exactMatch biolink:Biomarker ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "BMK" .

alskg:DiseaseSubtype a owl:Class ;
    rdfs:label "DiseaseSubtype" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:is_subtype_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:SubtypeScheme ;
            owl:onProperty alskg:has_subtype_scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:SubtypeCriterion ;
            owl:onProperty alskg:has_subtype_criterion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Disease ;
            owl:onProperty alskg:is_subtype_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_subtype_scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_subtype_criterion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_subtype_of ],
        alskg:ClinicalEntity ;
    skos:definition "Abstract class for a subtype of a disease, including clinical, genetic, molecular, pathology, and progression-based subtypes." ;
    skos:exactMatch alskg:DiseaseSubtype ;
    skos:inScheme alskg:alskg-schema .

<https://w3id.org/alskg/schema/DrugActionDirectionEnum#activates> a owl:NamedIndividual, alskg:DrugActionDirectionEnum ;
    rdfs:label "activates" ;
    skos:definition "Drug increases activity or function of the target." .

