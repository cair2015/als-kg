alskg:PhenotypeHierarchyRelationship a owl:Class ;
    rdfs:label "PhenotypeHierarchyRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Phenotype ;
            owl:onProperty alskg:subject ],
        alskg:HierarchyRelationship ;
    skos:definition """Hierarchy relationship between Phenotype nodes, or from a phenotype to a disease when the installed graph uses a PARENT pattern across those labels.

Property detail: Hierarchical relationships between HPO phenotype terms. Relation: PARENT (is_a, has_part within HPO ontology). Undirected: False. Count: 24,862. Source: HPO.""" ;
    skos:exactMatch okg:PhenotypeHierarchyRelationship ;
    skos:inScheme alskg:alskg-schema .

alskg:ProteinAggregate a owl:Class ;
    rdfs:label "ProteinAggregate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom alskg:EvidenceRecord ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:occurs_in_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:CellType ;
            owl:onProperty alskg:occurs_in_cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:has_protein_component ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Protein ;
            owl:onProperty alskg:has_protein_component ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty alskg:is_supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom alskg:Anatomy ;
            owl:onProperty alskg:occurs_in_anatomy ],
        alskg:PhysicalEntity ;
    skos:definition "An abnormal protein aggregate or pathological inclusion relevant to ALS, such as phosphorylated TDP-43 inclusions, SOD1 aggregates, FUS inclusions, or dipeptide-repeat protein aggregates." ;
    skos:exactMatch alskg:ProteinAggregate ;
    skos:inScheme alskg:alskg-schema ;
    alskg:recommended_neo4j_label "PAG" .

